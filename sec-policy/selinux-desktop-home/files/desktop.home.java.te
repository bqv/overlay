policy_module(desktop.home.java, 1.0)

gen_require(`
  type bin_t;
  type cgroup_t;
  type etc_runtime_t;
  type git_home_t;
  type java_t;
  type lib_t;
  type local_packet_t;
  type shell_exec_t;
  type staff_t;
  type user_bin_t;
  type user_home_dir_t;
  type user_home_t;
  type user_tmpfs_t;
  type usr_t;
  type xdg_data_t;
  class dir { add_name create getattr mounton open read remove_name search relabelfrom relabelto };
  class file { create getattr map open read unlink write relabelfrom relabelto };
  class packet { send recv };
  class process { execmem getcap noatsecure ptrace rlimitinh setexec setsched siginh transition };
  class process2 { nnp_transition nosuid_transition };
  class tcp_socket name_bind;
  class unix_stream_socket { getattr ioctl read write };
')

# --- r16: java_t is the Android build (gradlew, java, clang++, ndk-build) ---
#
# The per-role application domains get no user home access at all (see TRIAGE),
# and this one builds an APK under ~/var/work, so it needs the home content
# access any user build tool gets. Every line below names an AVC observed while
# that build ran; none of it is speculative.
userdom_manage_user_home_content_files(java_t)
userdom_manage_user_home_content_dirs(java_t)
allow java_t user_home_t:dir watch;
# ~/tmp is the build's scratch space (create/unlink/lock/map on the tmpfs mount)
manage_dirs_pattern(java_t, user_tmpfs_t, user_tmpfs_t)
manage_files_pattern(java_t, user_tmpfs_t, user_tmpfs_t)
# r20: the Gradle daemon binds a localhost port for its workers and listens on
# it. r16 granted the bind-any-unreserved-port and missed listen/accept itself, so
# a build would fail as soon as enforcement came on.
allow java_t self:tcp_socket { listen accept };
corenet_tcp_bind_generic_node(java_t)
corenet_udp_bind_generic_node(java_t);
# manage_files_pattern covers read/write but not mmap, and the build mmaps its
# scratch files in the user tmpfs.
mmap_read_files_pattern(java_t, user_tmpfs_t, user_tmpfs_t)

# The JVM allocates executable memory for its JIT: 99 denials. This is a W^X
# relaxation, but scoped to java_t rather than the global allow_execmem boolean,
# and without it Java does not run at all.
allow java_t self:process execmem;
# clang++ reads /etc/env.d/gcc to find the toolchain (etc_runtime_t is /etc/env.d
# here) - without this the NDK build cannot locate a compiler.
files_read_etc_runtime_files(java_t)
search_dirs_pattern(java_t, etc_runtime_t, etc_runtime_t)
# the daemon reads its cgroup; the NDK executes clang out of lib_t
fs_read_cgroup_files(java_t)
search_dirs_pattern(java_t, cgroup_t, cgroup_t)
allow java_t lib_t:file execute_no_trans;
term_use_ptmx(java_t)
# the Gradle daemon talks to its workers over loopback
allow java_t local_packet_t:packet { send recv };

# --- r16: staff_t launching those builds, and script(1) taking a pty ---
# The session runs under no_new_privs (the harness' sandbox), so every domain
# transition it makes needs the explicit nnp/nosuid permission. Without these the
# user cannot start a build or a git wrapper from the session at all.
allow staff_t java_t:process2 { nnp_transition nosuid_transition };
# --- r20c: the Android build's remaining gaps (part 2 of the sweep) ---
#
# java_t is where the Gradle/NDK build runs, and it has to execute the toolchain:
# /usr/bin tools (bin_t), shell scripts (shell_exec_t) and helpers out of /usr
# (usr_t). Without these the build fails the moment enforcing is on - 4463 AVCs in
# the retained logs, the largest single gap on the box. Same shape as what
# portage_t is granted for a build.
corecmd_exec_bin(java_t)
corecmd_exec_shell(java_t)
can_exec(java_t, usr_t)
mmap_read_files_pattern(java_t, bin_t, bin_t)
mmap_read_files_pattern(java_t, usr_t, usr_t)
mmap_read_files_pattern(java_t, shell_exec_t, shell_exec_t)
# Gradle and Maven fetch dependencies over https
corenet_sendrecv_http_client_packets(java_t)
# the daemon's listen port
corenet_tcp_bind_all_unreserved_ports(java_t)
# the home root, and the build tree's relabel/scratch behaviour
allow java_t user_home_dir_t:file { getattr read write };
allow java_t user_tmpfs_t:file { execute execute_no_trans relabelfrom };
getattr_dirs_pattern(java_t, user_tmpfs_t, user_tmpfs_t)
allow java_t user_home_t:file relabelto;
allow java_t user_home_t:dir { relabelfrom relabelto };
search_dirs_pattern(java_t, user_bin_t, user_bin_t)
search_dirs_pattern(java_t, xdg_data_t, xdg_data_t)
read_lnk_files_pattern(java_t, xdg_data_t, xdg_data_t)
getattr_dirs_pattern(java_t, git_home_t, git_home_t)
allow java_t staff_t:unix_stream_socket ioctl;
