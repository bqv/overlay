/usr/bin/dsh-native		--	gen_context(system_u:object_r:dsh_native_exec_t,s0)
/usr/share/dsh-native(/.*)?		gen_context(system_u:object_r:dsh_native_qml_t,s0)
HOME_DIR/\.dsh/\.credentials\.yaml		gen_context(system_u:object_r:dsh_credentials_t,s0)

# The client's ACP fallback spawns `/usr/bin/dsh --profile acp`, which COMPOSES its profile - it writes
# cordis.yml into ~/.dsh/profiles/<name> and replaces it. That subtree is harness state and was user_home_t, so
# the child (inheriting dsh_native_t) was denied write and exited 1 before speaking. Retyped as its own tree:
# the DIRECTORY ~/.dsh stays user_home_t as this module has insisted since r30, and staff_t keeps manage over
# the profile tree so the running harness is unaffected. Measured 2026-10-27.
HOME_DIR/\.dsh/profiles(/.*)?		gen_context(system_u:object_r:dsh_profile_t,s0)

# The harness's session records, for the same reason as profiles: a child spawned from the client runs as
# dsh_native_t and has to WRITE its session under ~/.dsh/sessions/<cwd-slug>/ (which is also how the headless
# pane failed). Same type, because it is the same class of thing - harness state the client's own children own.
HOME_DIR/\.dsh/sessions(/.*)?		gen_context(system_u:object_r:dsh_profile_t,s0)
# The dsh-linux work tree is deliberately NOT typed. It was, and it broke git: git runs in
# staff_git_t, which the module's manage patterns do not name, so every qml file under the
# repo became unreadable to it. A shared development directory belongs in user_home_t; the
# application's normal use reads /usr/share/dsh-native/qml, which is typed above.
# The harness entry point the client launches (/usr/bin/dsh is a symlink to it). It sits in the node
# module tree, where everything is lib_t, so `corecmd_exec_bin(dsh_native_t)` - which the module has
# carried since r32 - never applied: dsh_native_t was denied execute_no_trans on lib_t while the same
# client built in the work tree worked, because a work-tree binary stays in user_home_t and therefore
# runs as staff_t with no transition at all.
/usr/lib/node_modules/@deepseek-ai/dsh/lib/bin\.js	--	gen_context(system_u:object_r:bin_t,s0)
# A throwaway X server run by the USER gets user_tmp_t for its socket, because the tmp_t -> user_tmp_t
# transition applies to any socket a user process creates - whereas the xdm-run :0 gets xdm_tmp_t. That is the
# whole difference between "the packaged client works on :0" and "it aborts on :91". Give the throwaway displays
# the same label as the real one, so the same grant covers both:
#   Xvfb :91 ...  ;  restorecon -v /tmp/.X11-unix/X91
# Numbered 90+ deliberately: the real :0 and the existing :77/:123 are already xdm_tmp_t and must not be touched.
/tmp/\.X11-unix/X9[0-9]		--	gen_context(system_u:object_r:xdm_tmp_t,s0)
