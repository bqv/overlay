policy_module(desktop.home.gpg, 1.0)

# GnuPG as a user runs it in their session: the keyring daemon, the agent, and the
# terminal the passphrase prompt needs.
#
# These six rules were r29-r31 in desktop.system.base; r32 moved them here because
# they are about a *user's* gpg - which is what the desktop.home modules are for -
# and because base.te had by then accumulated gpg rules for three different
# domains alongside grants for sshd, semanage, nginx and udev.
#
# What each rule is for:
#
#   connectto   GnuPG 2.4's keyboxd binds /run/user/<uid>/gnupg/S.keyboxd, and both
#               it and the client run as gpg_t, so the client's connect() is a
#               gpg_t -> gpg_t check that refpolicy's gpg module does not grant.
#               Without it gpg2 retries the socket forever: 256 denials in three
#               minutes while portage was verifying a repository signature.
#
#   watch       keyboxd has to see keyring changes, in its own runtime dir and in
#               ~/.gnupg. `watch` only delivers inotify events for a directory; it
#               grants no read, and keyboxd could see neither.
#
#   ptmx        gpg in a session runs as gpg_t (the transition off gpg_exec_t) and
#               the passphrase path has to allocate a pty. gpg_agent_t and
#               gpg_pinentry_t were denied the identical { read write } on
#               /dev/ptmx, so all three carry the same set - exactly staff_t's own,
#               and no wider.
#
#               refpolicy's user-terminal bundles are deliberately NOT used here:
#               userdom_use_user_ptys grants user_devpts_t (the slave ptys,
#               /dev/pts/N) plus term_list_ptys, not ptmx_t - the policy separates
#               using a pty from allocating one - and this tree has no
#               dev_rw_ptmx interface at all.
#

gen_require(`
  type gpg_agent_t;
  type gpg_pinentry_t;
  type gpg_runtime_t;
  type gpg_secret_t;
  type gpg_t;
  type ptmx_t;
  type staff_t;
  type user_runtime_t;
	type user_tmp_t;
  class chr_file { getattr ioctl open read write };
  class dir { add_name create getattr mounton open read remove_name search relabelfrom relabelto };
  class process { execmem getcap noatsecure ptrace rlimitinh setexec setsched siginh transition };
  class unix_stream_socket { getattr ioctl read write };
')

allow gpg_t self:unix_stream_socket connectto;
allow gpg_t gpg_runtime_t:dir watch;
allow gpg_t gpg_secret_t:dir watch;

# r34: /run/user/<uid>/gnupg has to be BORN as gpg_runtime_t.
#
# Nothing types this directory at creation - refpolicy's only user_tmp_t:dir transitions
# are alsa, gconfd, httpd and mozilla_plugin - and the creator is not gpg itself: gpgconf
# runs as staff_t (gpg_agent_t and gpg_t have no access to user_tmp_t at all), and
# `gpgconf --launch`, which the session's gpg-agent supervisor uses as its health probe,
# is what creates it. So it inherited the parent's user_tmp_t and every rule in this
# module about gpg_runtime_t went dead: the agent could not even stat its own socket
# directory, and the supervisor restarted it every few seconds all afternoon - 1590
# identical { getattr } denials, and no agent at all. matchpathcon already declares
# gpg_runtime_t for this path; only the creation-time transition was missing.
# user_runtime_t, not user_tmp_t: /run/user/1000 carries user_runtime_t, so a transition
# from user_tmp_t never fires. The earlier version was dead code and the manual restorecon
# beside it made the directory look fixed - until the reboot at 18:25 recreated it. /run is
# ephemeral, so this must happen at creation time, in the policy, not by hand after a boot.
filetrans_pattern(staff_t, user_runtime_t, gpg_runtime_t, dir, "gnupg")

allow gpg_t ptmx_t:chr_file rw_chr_file_perms;
allow gpg_agent_t ptmx_t:chr_file rw_chr_file_perms;
allow gpg_pinentry_t ptmx_t:chr_file rw_chr_file_perms;

# r33: a session shell must be able to reach the agent
#
# gpg, gpgconf and pass become gpg_t via the transition off gpg_exec_t, and gpg_t
# already had the runtime socket permissions. gpg-connect-agent does NOT transition
# - it stays staff_t - so from a plain session shell it reported "no gpg-agent
# running in this session" with a live agent behind it, because staff_t is denied
# `search` on gpg_runtime_t. That is also the path the ssh agent needs
# (SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/gnupg/S.gpg-agent.ssh).
#
# refpolicy has the interface for exactly this: gpg_stream_connect_agent grants the
# client connectto on gpg_agent_tmp_t - the type the agent's sockets actually carry
# in /run/user/<uid>/gnupg - plus directory search on gpg_runtime_t and
# gpg_secret_t. ssh.if and systemd.if call it for their own domains, so this is the
# policy's own answer rather than a grant of my invention.
gpg_stream_connect_agent(staff_t)

# A shell that runs with no_new_privs - the DSH tool sandbox does, so anything run
# through it - execs gpg with NNP set, and SELinux then refuses the transition to
# gpg_t unless nnp_transition is granted. The denial does not stop gpg: it runs, but
# as staff_t, i.e. with the session's much wider access instead of gpg's own. Granting
# this restores the confinement rather than loosening it, which is why it is worth
# having even though nothing appears to fail.
#
# all_process2_perms is refpolicy's own { nnp_transition nosuid_transition } - the same
# set bubblewrap.if and misc_patterns.spt use for this.
allow staff_t gpg_t:process2 all_process2_perms;
allow staff_t gpg_agent_t:process2 all_process2_perms;


dontaudit staff_t gpg_t:process { noatsecure rlimitinh siginh };
