policy_module(desktop.home.firefox, 1.0.0)

gen_require(`
  type mozilla_tmp_t;
  type mozilla_tmpfs_t;
  type user_fonts_cache_t;
  type gnome_xdg_config_t;
  type proc_psi_t;
  type sysctl_vm_overcommit_t;
  type user_home_t;
  type user_runtime_t;
  type xdg_cache_t;
  class file { create getattr ioctl lock map open read relabelfrom relabelto rename setattr unlink write };
  type var_lib_t;
  type xserver_t;
  type xserver_tmpfs_t;
  class unix_dgram_socket sendto;
	role staff_r;
	type staff_t;
	type mozilla_t;
	type stremio_server_t;
	type unreserved_port_t;
	type user_runtime_t;
	type var_lib_t;
')

allow mozilla_t unreserved_port_t:tcp_socket name_connect;
allow mozilla_t user_runtime_t:sock_file write;
mmap_read_files_pattern(mozilla_t, var_lib_t, var_lib_t)
corenet_sendrecv_dns_client_packets(stremio_server_t)
corenet_sendrecv_http_client_packets(stremio_server_t)
# r19: the unlabeled_t blanket is replaced by dynamic_packet_t
# (declared in desktop.system.network.te), which labels the same
# traffic instead of leaving it unlabelled.
corenet_tcp_connect_http_port(stremio_server_t)
corenet_udp_bind_generic_node(mozilla_t)
dev_read_video_dev(mozilla_t)
dev_watch_dev_dirs(mozilla_t)
files_exec_usr_files(mozilla_t) # glxtest,crashhelper
#files_watch_var_lib_dirs(mozilla_t) # flatpak?
fs_read_cgroup_symlinks(mozilla_t)
pipewire_play(mozilla_t)
xdg_watch_config_dirs(mozilla_t)
xdg_watch_data_dirs(mozilla_t)

# r21: the browser watching the flatpak export share, talking to the X server's
# dgram socket and writing its compositor tmpfs.
allow mozilla_t var_lib_t:dir watch;
allow mozilla_t xserver_t:unix_dgram_socket sendto;
allow mozilla_t xserver_tmpfs_t:file write;

# r21b: the browser's runtime dir, cache creates, psi and the overcommit sysctl.
allow mozilla_t proc_psi_t:dir search;
allow mozilla_t sysctl_vm_overcommit_t:file read;
allow mozilla_t user_home_t:dir create;
allow mozilla_t user_runtime_t:dir create;
allow mozilla_t xdg_cache_t:file create;

# r24: psi's memory file (r21b only had its dir), gtk's config dir, the font
# cache symlink, and mapping the compositor tmpfs.
allow mozilla_t proc_psi_t:file read;
allow mozilla_t gnome_xdg_config_t:dir search;
allow mozilla_t user_fonts_cache_t:lnk_file create;
allow mozilla_t xserver_tmpfs_t:file map;

# r25: writing its own temp files and executing them, the nvidia shader cache,
# reading gtk's config (not just searching the dir) and opening psi.
allow mozilla_t mozilla_tmpfs_t:file execute;
allow mozilla_t mozilla_tmp_t:file execute;
allow mozilla_t xdg_cache_t:file { append getattr lock open read write };
allow mozilla_t gnome_xdg_config_t:file { open read };
allow mozilla_t proc_psi_t:file { getattr open read };
