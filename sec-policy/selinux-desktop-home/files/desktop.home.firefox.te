policy_module(desktop.home.firefox, 1.0.0)

gen_require(`
	role staff_r;
	type staff_t;
	type mozilla_t;
	type stremio_server_t;
	type unreserved_port_t;
	type user_runtime_t;
	type var_lib_t;
')

allow mozilla_t unreserved_port_t:tcp_socket name_connect;
allow mozilla_t user_runtime_t:sock_file write;
allow mozilla_t var_lib_t:file map;
corenet_sendrecv_dns_client_packets(stremio_server_t)
corenet_sendrecv_http_client_packets(stremio_server_t)
# r19: the unlabeled_t blanket is replaced by dynamic_packet_t
# (declared in desktop.system.network.te), which labels the same
# traffic instead of leaving it unlabelled.
corenet_tcp_connect_http_port(stremio_server_t)
corenet_udp_bind_generic_node(mozilla_t)
dev_read_video_dev(mozilla_t)
dev_watch_dev_dirs(mozilla_t)
files_exec_usr_files(mozilla_t) # glxtest,crashhelper
#files_watch_var_lib_dirs(mozilla_t) # flatpak?
fs_read_cgroup_symlinks(mozilla_t)
pipewire_play(mozilla_t)
xdg_watch_config_dirs(mozilla_t)
xdg_watch_data_dirs(mozilla_t)
