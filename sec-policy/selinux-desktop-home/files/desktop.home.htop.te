policy_module(desktop.home.htop, 1.0.0)

gen_require(`
  type staff_t;
  role staff_r;
  type xdg_config_t;
  type tty_device_t;
  attribute domain;
  class file { getattr open read write };
  class process { getcap getsched setcap setrlimit };
  class capability sys_ptrace;
  class cap_userns sys_ptrace;
  class chr_file { getattr ioctl read write };
')

########################################
#
# Declarations
#

type htop_t;
type htop_exec_t;
application_domain(htop_t, htop_exec_t)
role staff_r types htop_t;

########################################
#
# htop local policy
#

# THE POINT OF THIS MODULE. Reading /proc/<pid>/attr/current goes through
# selinux_getprocattr(), which checks `process getattr` against the *target*
# domain and passes no audit data - so the denial never reaches the audit log.
# That is why htop printed n/a for every non-user process while ausearch showed
# nothing at all, and why no amount of reading the log would have found it.
#
# Only htop gets the permission. The domain is entered by a transition on
# htop_exec_t, so ps, top, pgrep and every other staff_t process still cannot
# read another domain's context.
domain_getattr_all_domains(htop_t)

# the rest of what htop displays: every process's state, the machine's sensors
# and what /etc says about them
domain_read_all_domains_state(htop_t)
kernel_read_system_state(htop_t)
dev_read_sysfs(htop_t)
files_read_etc_files(htop_t)
miscfiles_read_localization(htop_t)

# it still has to run in a terminal and read its own htoprc
userdom_use_user_terminals(htop_t)
userdom_search_user_home_dirs(htop_t)
read_files_pattern(htop_t, xdg_config_t, xdg_config_t)

htop_domtrans(staff_t, staff_r);
htop_exec(staff_t);

#============= htop_t ==============

# the first permissive run of the new domain, triaged. refpolicy has no
# all-domains interface for getcap, so it is written out - the same idiom the
# root/sysadm_t side already uses for htop (`allow sysadm_t domain:process
# getcap;`).
allow htop_t domain:process getcap;

# /proc/sys/kernel (pid_max, threads-max), the namespaces htop lists, nscd's
# runtime dir, /dev/tty itself, and writing htoprc back on exit.
kernel_read_kernel_sysctls(htop_t)
fs_getattr_nsfs_files(htop_t)
nscd_read_runtime_files(htop_t)
allow htop_t tty_device_t:chr_file { getattr ioctl read write };
rw_files_pattern(htop_t, xdg_config_t, xdg_config_t);
allow htop_t self:process { setcap getsched setrlimit };

# /usr/bin/htop carries cap_sys_ptrace=ep; setcap *is* how htop drops or
# re-arranges its own capability set, so the two go together.
allow htop_t self:capability sys_ptrace;
allow htop_t self:cap_userns sys_ptrace;

# the shell that started htop has to be able to interrupt it (Ctrl-C)
allow staff_t htop_t:process { signal sigkill signull };
