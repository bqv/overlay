policy_module(desktop.home.mpv, 1.0)

gen_require(`
  type boolean_t;
  type mplayer_t;
  type pipewire_t;
  type staff_t;
  type tmpfs_t;
  type user_runtime_t;
  type xserver_t;
  type xserver_tmpfs_t;
  class fd use;
  class dir search;
  class file { append getattr ioctl lock map open read write };
  class process { execmem setrlimit };
  class process2 { nnp_transition nosuid_transition };
  class sock_file write;
  class unix_dgram_socket sendto;
')

# mpv v0.41 is LuaJIT-skinned - ldd shows libluajit-5.1 - and its default scripts each
# compile Lua and then mprotect the result PROT_READ|PROT_EXEC. SELinux gates that with
# execmem, so the scripts die one after another and playback fails: lua/osc at 17:50 and
# lua/stats at 18:11 were the same permission on two different scripts, which is why
# blaming "the OSC" was wrong.
#
# Scoped to mplayer_t rather than the global allow_execmem boolean, exactly as the java_t
# rule does for the JVM JIT. mpv is the only thing this domain runs.
allow mplayer_t self:process execmem;

# ...and the sandboxed case. With no_new_privs set - which the DSH tool sandbox always
# does - SELinux refuses the staff_t -> mplayer_t transition unless nnp_transition is
# granted, so a timeout-wrapped mpv runs as staff_t instead: a wider domain that has no
# execmem either, so it failed both ways. Granting this restores the confinement rather
# than loosening it, the same argument as the gpg and java rules.
#
# all_process2_perms is refpolicy own { nnp_transition nosuid_transition }.
allow staff_t mplayer_t:process2 all_process2_perms;

# --- r25: the GUI client set ---
#
# With execmem granted, mpv got past the LuaJIT wall and was then denied every client path
# a desktop application needs: sendto on the X socket, write on the NVIDIA driver shared
# memfd, session and system D-Bus sockets, the pipewire socket, and libplacebo shader
# cache under ~/.cache.
#
# refpolicy builds an X domain template for this domain (xserver_user_x_domain_template,
# mplayer.te:235) and it grants fd use on xserver_t - but nothing else this mpv needs, and
# the denials above name exactly what is missing. The set below is the same set the other
# GUI clients carry - now one interface, desktop_home_gui_client in desktop.home.if, since
# r37. mplayer_t is the one client that cannot call it: refpolicy already gives this domain
# everything in it except domain_use_interactive_fds, so the call would add a permission
# rather than factor one out. (No backticks in these comments: m4 uses
# them as quote characters, and an unmatched one eats the rest of the file.)
allow mplayer_t xserver_t:unix_dgram_socket sendto;
allow mplayer_t xserver_tmpfs_t:file { map read write };
xserver_read_user_xauth(mplayer_t)
xserver_stream_connect(mplayer_t)
xserver_use_user_fonts(mplayer_t)
dbus_list_system_bus_runtime(mplayer_t)
dbus_rw_session_tmp_sockets(mplayer_t)
dbus_send_system_bus(mplayer_t)
dbus_system_bus_client(mplayer_t)
pipewire_play(mplayer_t)
xdg_manage_cache(mplayer_t)
# pipewire socket carries user_runtime_t here, not a pipewire type - the denial named
# /run/user/1000/pipewire-0 directly - and shortwave carries the same one-line grant.
allow mplayer_t user_runtime_t:sock_file write;
# libplacebo, and the NVIDIA blob behind it, read the allow_execmem boolean to decide
# whether runtime shader compilation is permitted. A boolean value is not a privilege -
# getsebool works for any user - and without this read the VO path cannot tell.
allow mplayer_t boolean_t:file { open read };

# --- r26: the audio and bus paths a real session uses ---
#
# r25 was verified with audio off and no session bus, so these were never exercised; the
# owner's own run at 18:33 hit all of them. The boolean line above is the same lesson at
# close range: r25 granted read because one AVC named read, and the next real run asked for
# open as well. One AVC names the permission the kernel stopped at, not the set.
#
# The boolean read stays raw - refpolicy wraps that type only for SETTING booleans, inside
# selinux_set_generic_booleans - and it is now open beside read.
#
# The session bus socket and the system bus name use the dbus module's own interfaces for
# exactly those two permissions; dbus_system_bus_client, already called above, grants only
# send_msg in each direction, which is why neither came for free.
dbus_write_session_runtime_socket(mplayer_t)
# ...and the stat that precedes connecting to it; the dbus module names this one too.
dbus_getattr_session_runtime_socket(mplayer_t)
dbus_connect_system_bus(mplayer_t)
# pipewire passes the client a memfd over SCM_RIGHTS, so the client must be allowed to use
# a descriptor it receives from pipewire_t. wireplumber carries the same single rule.
allow mplayer_t pipewire_t:fd use;
# module-rt asks for an RT rlimit before falling back to rtkit. refpolicy silences exactly
# this request for user domains (userdomain.if:988, dontaudit $1_t self:process setrlimit),
# so the failing request is the design rather than a fault. Silenced, not granted, and that
# is upstream's judgement rather than mine.
dontaudit mplayer_t self:process setrlimit;

# --- r27: pipewire's memfd ---
#
# pipewire hands the client a buffer over SCM_RIGHTS. The descriptor arrives under
# pipewire_t (r26 grants fd use) and the buffer itself is a plain tmpfs_t file, so the write
# is checked against tmpfs_t. refpolicy does not type these - there is no pipewire_tmpfs_t
# and no transition out of pipewire_t - and the box's working audio clients carry plain
# tmpfs_t grants: mozilla_t from refpolicy, crow_t and gajim_t from this tree, both via
# manage_files_pattern. This pair is the narrower macro form for a client that only reads
# and writes a buffer it was handed, without create, unlink or rename.
rw_files_pattern(mplayer_t, tmpfs_t, tmpfs_t)
mmap_read_files_pattern(mplayer_t, tmpfs_t, tmpfs_t)
