/opt/android-sdk/platform-tools/adb		--	gen_context(system_u:object_r:android_tools_exec_t,s0)
# r39: the SDK build is 36.0.0 and its adbwifi TLS handshake fails against this phone -
# "Handshake failed in SSL_accept/SSL_connect [invalid library (0)]", the phone closing the
# handshake - while the system build (36.0.1, android-tools) completes it with the same key,
# the same phone and the same known_hosts. adbtrack is pinned to the system build, so it
# needs the same label or its USB access would fall back to staff_t. The transition keys on
# the type, not the path: android_tools_domtrans(staff_t) grants the entrypoint on
# android_tools_exec_t.
/usr/bin/adb					--	gen_context(system_u:object_r:android_tools_exec_t,s0)
# r56: fastboot is bin_t in the system package and usr_t in the SDK, so it inherited the caller's
# domain and was denied usb_device_t write. It is a pure USB client, so it goes to the same domain
# as adb - but with its own exec type, because android_tools_exec_t's staff_t transition is
# adbtrack_t's alone since r42 (see desktop.home.adb.te, r56).
/usr/bin/fastboot				--	gen_context(system_u:object_r:fastboot_exec_t,s0)
/opt/android-sdk/platform-tools/fastboot	--	gen_context(system_u:object_r:fastboot_exec_t,s0)
# r42: the service binary gets its own domain, so "who may become the adb server domain" has an
# answer other than "anything in the session".
/home/user/bin/adbtrack			--	gen_context(system_u:object_r:adbtrack_exec_t,s0)
