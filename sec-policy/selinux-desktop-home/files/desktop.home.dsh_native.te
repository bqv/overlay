policy_module(desktop.home.dsh_native, 1.0)

gen_require(`
	type xdg_config_t;
	type mesa_shader_cache_t;
	type user_bin_t;
	type user_tmp_t;
')

gen_require(`
	attribute user_home_content_type;
	role staff_r;
	type staff_t;
	type local_packet_t;
	type staff_dbusd_t;
	type tmpfs_t;
	type user_home_t;
	type user_runtime_t;
	type user_tmp_t;
	type xserver_t;
	type xserver_tmpfs_t;
')

########################################
#
# Declarations
#

attribute_role dsh_native_roles;
roleattribute system_r dsh_native_roles;

type dsh_native_t;
type dsh_native_exec_t;
application_domain(dsh_native_t, dsh_native_exec_t)
role dsh_native_roles types dsh_native_t;

# r30: its own JIT memory. Qt's QML engine writes a memfd and mprotects it executable;
# execmod is the permission for modified FILE-backed memory, and it is the risky member of
# the W^X trio. Giving this domain a tmpfs type of its own keeps that permission on the
# application's own buffers: the transition below fires for every memfd dsh_native_t creates,
# and neither may anything else execute those, nor this domain execute any other tmpfs file.
# files_type() sets the file_type attribute - it does not declare the type, so the type line is
# still required. The attribute is what lets setfiles_t relabel files into it, and what every
# other file type on this box carries.
type dsh_native_tmpfs_t;
files_type(dsh_native_tmpfs_t)
type_transition dsh_native_t tmpfs_t:file dsh_native_tmpfs_t;

# r30: its own QML. /usr/share/dsh-native belongs to this package, so its files get a type of
# their own instead of sitting in usr_t, and the live-reload watch stays inside that tree.
type dsh_native_qml_t;
files_type(dsh_native_qml_t)

# The credentials the application authenticates with when it talks to the harness. They live
# in ~/.dsh, which stays user_home_t: retyping that directory would retype the harness's own
# state, which this session runs on. Only the file gets a type, so dsh_native_t can read it
# without holding read on the whole home directory (it runs as the user, so DAC is no help:
# a user_home_t read would include the SSH keys).
type dsh_credentials_t;
files_type(dsh_credentials_t)
typeattribute dsh_credentials_t user_home_content_type;
# user_home_content_type is the attribute user_home_t carries and the userdomain rules
# key on, so keeping it means retyping the work-tree QML does not cost the session its own
# access to files it edits.
typeattribute dsh_native_qml_t user_home_content_type;

########################################
#
# dsh-native local policy
#

allow dsh_native_t self:process { fork getsched setpgid setrlimit signal_perms };
allow dsh_native_t self:fifo_file manage_fifo_file_perms;
allow dsh_native_t self:unix_stream_socket create_stream_socket_perms;
allow dsh_native_t self:unix_dgram_socket { connect create ioctl };
allow dsh_native_t self:shm { create destroy read unix_read unix_write write };

files_read_etc_files(dsh_native_t)
auth_use_nsswitch(dsh_native_t)
miscfiles_read_localization(dsh_native_t)
files_list_usr(dsh_native_t)

dsh_native_run(staff_t, staff_r)

# The QML it displays and the file-change watch that reloads it. watch is a notification and
# grants no read, and it is scoped to this package's own tree rather than usr_t.
allow dsh_native_t dsh_native_qml_t:file { getattr map open read watch };
allow dsh_native_t dsh_native_qml_t:dir { getattr open read search watch };
# The work-tree QML carries the same type (see the fc entry), so the grants above cover the
# --qml case without opening the whole home directory to this domain. The session watches it
# too, so a reload watcher run by hand from the work tree behaves the same way.
# Measured, not assumed: the userdomain rules keyed on user_home_content_type do NOT cover
# staff_t (this file_type attribute alone left it with watch and nothing else), so the session
# access to these files is stated here. It mirrors what staff_t holds on user_home_t: manage,
# which is what an editor needs - create, rename and unlink included, because editors save by
# replacing - plus the watch that r29 added to user_home_t.
manage_dirs_pattern(staff_t, dsh_native_qml_t, dsh_native_qml_t)
manage_files_pattern(staff_t, dsh_native_qml_t, dsh_native_qml_t)
allow staff_t dsh_native_qml_t:dir watch;
allow staff_t dsh_native_qml_t:file watch;
# Its JIT buffers: map in, write, and execute what it wrote itself, and nothing else.
allow dsh_native_t dsh_native_tmpfs_t:file { execmod execute mmap_rw_file_perms };

allow dsh_native_t user_tmp_t:file { append create getattr map open read write };
allow dsh_native_t user_runtime_t:sock_file write;

corecmd_exec_bin(dsh_native_t)
corecmd_search_bin(dsh_native_t)
dbus_connect_system_bus(dsh_native_t)
dbus_getattr_session_runtime_socket(dsh_native_t)
dbus_list_system_bus_runtime(dsh_native_t)
dbus_send_system_bus(dsh_native_t)
dbus_write_session_runtime_socket(dsh_native_t)
# The GUI client set every desktop application here needs - see desktop.home.if.
desktop_home_gui_client(dsh_native_t)
# The X socket, the session's descriptor for it and the user font path:
# desktop.home.if.
desktop_home_x11_client(dsh_native_t)
dev_ioctl_dri_dev(dsh_native_t)
dev_read_sysfs(dsh_native_t)
dev_rw_dri(dsh_native_t)
files_mmap_read_usr_files(dsh_native_t)
files_read_etc_runtime_files(dsh_native_t)
fs_getattr_xattr_fs(dsh_native_t)
fs_list_tmpfs(dsh_native_t)
kernel_read_system_state(dsh_native_t)
miscfiles_manage_fonts(dsh_native_t)
miscfiles_manage_fonts_cache(dsh_native_t)
miscfiles_read_fonts(dsh_native_t)
userdom_search_user_runtime(dsh_native_t)
userdom_use_inherited_user_terminals(dsh_native_t)
userdom_use_user_ttys(dsh_native_t)
xdg_manage_data(dsh_native_t)
xdg_read_config_files(dsh_native_t)
xdg_search_config_dirs(dsh_native_t)

# --- r32: the launch, collected through the permissive window ---
#
# Everything here names a denial from the first real run. The transport is the socket error
# the owner hit: the application talks to the DSH carrier on loopback TCP 8081, which the
# policy labels transproxy_port_t, and loopback traffic is local_packet_t - a type no
# interface grants, so the packet permission is stated directly.
allow dsh_native_t local_packet_t:packet { send recv };
corenet_tcp_connect_transproxy_port(dsh_native_t)
# term_use_ptmx, not term_create_pty: that one takes (domain, pty_type) and expands a
# type_transition from its second argument, so calling it with one argument emits
# "type_transition dsh_native_t devpts_t:chr_file ;" - a rule nobody wrote. Both interfaces
# grant the same ptmx permission.
term_use_ptmx(dsh_native_t)
# The session bus daemon here is staff_dbusd_t, not the dbus module's own types; shortwave
# carries the same line.
allow dsh_native_t staff_dbusd_t:unix_stream_socket connectto;
# Traversal only, so it can reach its credentials file: search, not read or list.
allow dsh_native_t user_home_t:dir search;
allow dsh_native_t dsh_credentials_t:file { getattr open read };
# It inspects the process that launched it (the harness) - /proc/<pid>/exe and friends. This
# is the standard ps_process_pattern set, scoped to staff_t rather than all domains.
ps_process_pattern(dsh_native_t, staff_t)
# The harness keeps its own access to the credentials file: manage, plus map and watch, the
# parts of what staff_t holds on user_home_t that mean anything for this file.
manage_files_pattern(staff_t, dsh_credentials_t, dsh_credentials_t)
allow staff_t dsh_credentials_t:file { map watch };

# --- r73: two more, both from the first offscreen run of the PACKAGED client (2026-10-25) ---
#
# (1) Its launcher could not stop it. `timeout` (staff_t) sent SIGTERM four times and every one was denied:
#     { signal } for comm="timeout" tcontext=dsh_native_t tclass=process
# so only a SIGKILL from outside ended it. Whatever starts a GUI application must be able to stop it.
allow staff_t dsh_native_t:process { getattr sigchld sigkill signal signull };
#
# (2) It cannot save its own settings: writing ~/.config/dsh-native.conf (xdg_config_t) is denied, twice in
# the run. xdg_manage_data covers its data directory, not its config file, and the read-only config
# interfaces only grant read.
allow dsh_native_t xdg_config_t:file { getattr open read write };

# --- r75: the in-app restart, settings persistence, and the udmabuf node ---
#
# (1) "Restart client" is QProcess::startDetached() of /usr/bin/dsh-native FROM INSIDE dsh_native_t - the
#     client replaces itself, so it must be allowed to exec its own entry point without a transition (the new
#     instance is the same application and stays in this domain):
#       avc: denied { execute_no_trans } for comm="dsh-native" path="/usr/bin/dsh-native"
#            tcontext=dsh_native_exec_t tclass=file
#     application_domain() gave it entrypoint/execute for the LAUNCHER path but not this one.
allow dsh_native_t dsh_native_exec_t:file { execute execute_no_trans };
#
# (2) Settings persistence - window geometry, composer preference: QSettings creates or locks a file INSIDE
#     ~/.config/dsh, so the directory needs the create-entry permissions, not just the file write granted in r73:
#       avc: denied { write } for comm="dsh-native" name="dsh" tcontext=xdg_config_t tclass=dir
allow dsh_native_t xdg_config_t:dir { add_name write };
#
# (3) /dev/udmabuf (dma_device_t) - read and write. Seen from the DEV build of the same client running as
#     staff_t, so both domains get it: it is a generic DRM/dma-buf helper any GUI renderer may touch, not
#     something specific to this application.
dev_rw_dma_dev(dsh_native_t)
dev_rw_dma_dev(staff_t)

# --- r76: QSettings writes atomically, so the lock and the temp file need create ---
#
# The session's diagnosis was exact: QSettings writes "<file>.lock" plus a temp file and silently abandons the
# write when it cannot create them, so the r73 file *write* was never reached. 227 denials of one permission,
# every few seconds (Qt retries):
#   { create } for comm="dsh-native" name="dsh-native.conf.lock" tcontext=xdg_config_t tclass=file
# The atomic replace then renames over the old file and unlinks the lock, and the directory needs remove_name
# to go with r75's add_name.
allow dsh_native_t xdg_config_t:file { create rename setattr unlink };
allow dsh_native_t xdg_config_t:dir { remove_name };
#
# The shader cache: search and getattr on the directory, and the files themselves so it can populate. Every GUI
# renderer does this; without it the cache never fills and first paint stays slow.
allow dsh_native_t mesa_shader_cache_t:dir { getattr search };
allow dsh_native_t mesa_shader_cache_t:file { create getattr open read write };
#
# Its own process: getcap (11) and setsched (7) - Qt and render threads inspecting and prioritising themselves.
# Self-only, so the scope is the domain's own threads.
allow dsh_native_t self:process { getcap setsched };
#
# /proc/sys/dev: it probes the DRM device sysctls at startup (16 denials). sysctl_vm_overcommit_t (6 reads) is
# left alone for now - nothing fails without it.
kernel_read_device_sysctls(dsh_native_t)

# --- r77: Qt commits an atomic save with link(2), not rename(2) ---
#
# r76's create/rename/setattr/unlink let QSettings get as far as writing its temp file and then it failed on
# the COMMIT, so every write was still dropped and nothing persisted:
#   syscall=linkat success=no exit=EACCES
#   { link } for comm="dsh-native" name=#25600579 tcontext=xdg_config_t tclass=file
# QSaveFile links the temp file onto the target and then unlinks the temp; rename is the other, older strategy.
# The session proved it in the real domain (offscreen, real ~/.config) and confirmed link is the only remaining
# denial on xdg_config_t in the whole run.
allow dsh_native_t xdg_config_t:file { link };

# --- r78: the owner's instruction - the file chooser lists nothing and nothing can be attached ---
#
# "dsh_native_t needs far broader file access perms, because i can't attach a thing currently, the file chooser
# opens and shows nothing, and probably couldn't attach it if it could." (owner, 2026-10-25)
#
# Measured: the module had only `user_home_t:dir search` - traversal - so a chooser could walk to a path but
# never LIST a directory, and there was no file rule for user_home_t at all:
#   { getattr } for path="/home/user/.dsh/attachments/md-images-check.png" tcontext=user_home_t tclass=file
# An image referenced by absolute path falls back to caption text for the same reason.
#
# userdom_read_user_home_content_files gives read_dir_perms on user_home_dir_t and user_home_t (getattr, open,
# read, SEARCH - which is what listing a directory needs) and read_file_perms on the files, plus the symlink
# reads. map is separate: rendering an image mmaps it, and the interface does not carry map.
userdom_read_user_home_content_files(dsh_native_t)
allow dsh_native_t user_home_t:file { map };
#
# The shader cache was granted in r76 without map, so the index itself could not be mapped (one denial here).
allow dsh_native_t mesa_shader_cache_t:file { map };
#
# Its own QML tree: a symlink inside /usr/share/dsh-native/qml/text was denied read, which the file/dir grants in
# the module never covered.
allow dsh_native_t dsh_native_qml_t:lnk_file { getattr read };

# --- r79: read_dir_perms is not enough to LIST a directory ---
#
# r78's userdom_read_user_home_content_files gives { getattr open search } on the home directories. Listing them
# needs read as well (a directory listing is read(2) on the directory; search is only the permission to walk
# through it), so the file chooser would still have shown nothing. staff_t's own home grant carries read for the
# same reason. Verified against the loaded rule rather than assumed from the interface name.
allow dsh_native_t { user_home_dir_t user_home_t }:dir read;

# --- r80: the home tree is not one type, and inotify needs watch ---
#
# The owner: "there are still some lingering selinux grants missing evidently though - i couldn't enter bin/ or
# tmp/". The r78/r79 read grant covers user_home_t and user_home_dir_t only; this tree types parts of the home
# directory separately, so a chooser stops dead at two of the owner's most-used folders:
#   /home/user/bin -> user_bin_t     (also ~/.local/share/pnpm)
#   /home/user/tmp -> user_tmp_t     (the scoped scratch dir)
# and the same run shows the client's inotify failing on /home/user/{bin,tmp,var,etc}:
#   inotify_add_watch(/home/user/bin) failed: (Permission denied)
# inotify_add_watch is the dir `watch` permission, which none of the home grants carry - staff_t holds it on all
# of these types (with watch_reads/watch_sb), which is why a shell has no trouble.
allow dsh_native_t { user_home_dir_t user_home_t user_bin_t user_tmp_t }:dir watch;

# Read and list ~/bin. Its files are the user's scripts and the pnpm store, so read-only: nothing here executes
# or writes them.
allow dsh_native_t user_bin_t:dir { getattr open read search };
allow dsh_native_t user_bin_t:file { getattr open read map };

# ~/tmp: the file perms have been here since r30 (the client's own scratch), the DIRECTORY was never granted,
# so it could write into it by path but not list it.
allow dsh_native_t user_tmp_t:dir { getattr open read search };
