policy_module(desktop.home.adb, 1.0)

gen_require(`
	type android_tools_t;
	type staff_t;
	type staff_screen_t;
	type dynamic_packet_t;
	type mdns_packet_t;
	type local_packet_t;
	type adb_client_packet_t;
	type user_tmp_t;
	type user_home_t;
	type user_runtime_t;
	role staff_r;
	attribute defined_port_type;
	attribute port_type;
')

# r35: adb runs in refpolicy's own android_tools_t domain, not in staff_t.
#
# refpolicy labels android_tools_exec_t for /opt/android-sdk-update-manager/platform-tools/adb;
# this box SDK lives at /opt/android-sdk/platform-tools/adb, so the fcontext in the .fc here
# never matched, adb inherited staff_t, and the USB device access had to be granted to the
# whole session - including the nodes for the keyboard and mouse. Labelling the real path puts
# adb back in the domain that already holds usb_device_t itself, and staff_t goes back to
# having nothing on /dev/bus/usb.
#
# android_tools_domtrans is refpolicy's own entry, which also grants the entrypoint on the
# exec type. It was granted to staff_t here until r42; it is now granted to adbtrack_t alone
# (below), because that transition IS the ability to start a server: it is what puts a process
# in the one domain that may bind the adb port. A session process that runs adb is now a pure
# client - it reaches 5037 through port_type and cannot hold it.

# android_tools_t reads and writes usb_device_t but does NOT watch the bus directories, so a
# phone plugged in after the server started was never noticed - which is exactly the reported
# symptom. dev_watch_dev_dirs is the policy own interface for that watch.
dev_watch_dev_dirs(android_tools_t)

# --- r35b: what the shipped domain lacks, collected from one run of the real thing ---
#
# A permissive window on android_tools_t, one adb start, then ausearch. Every line names a
# denial the run produced. staff_t had all of this; the domain transition took it away:
#
#   /tmp/adb.<uid>.log    append create getattr open read write   (the server ABORTS without
#                         it: "cannot open /tmp/adb.1000.log: Permission denied", so this one
#                         is not cosmetic)
#   /usr/share/zoneinfo   read    (why its log timestamps came out in UTC)
#   /dev/urandom          read
#   /dev/ptmx             read write
#   UDP 5353 + node bind  adb's own mDNS, alongside the adb-wireless service
#   unassigned TCP ports  the emulator scan, which is why it wants 5555 and friends
#   netlink uevent socket udev-style hotplug, alongside libusb's /dev/bus/usb watch
userdom_write_user_tmp_files(android_tools_t)
allow android_tools_t user_tmp_t:file read;
miscfiles_read_localization(android_tools_t)
dev_read_urand(android_tools_t)
term_use_ptmx(android_tools_t)
corenet_udp_bind_howl_port(android_tools_t)
corenet_udp_bind_generic_node(android_tools_t)
corenet_tcp_connect_all_unreserved_ports(android_tools_t)
udev_create_kobject_uevent_sockets(android_tools_t)

# --- r35c: the packet-level grants and the uevent socket, from the same window ---
#
# adb finds devices over mDNS (mdns_packet_t, multicast to 224.0.0.251 on both the wired and
# wireless interfaces), talks to its own server over loopback (adb_client_packet_t - this box
# own type for exactly that, from the network module - plus local_packet_t for the emulator
# scan around 5555), and uses a netlink uevent socket for udev-style hotplug alongside libusb
# watch of /dev/bus/usb.
#
# udev_create_kobject_uevent_sockets granted nothing for this domain - verified by asking
# sesearch what it actually put in place, which came back empty - so the socket permissions
# are stated directly from the denials instead of trusting the interface name.
allow android_tools_t self:netlink_kobject_uevent_socket { bind create getattr read setopt };
allow android_tools_t local_packet_t:packet { send recv };
allow android_tools_t adb_client_packet_t:packet { send recv };
allow android_tools_t mdns_packet_t:packet { send recv };
# create as well: /tmp is tmpfs, so after a reboot the log is gone and the server has to make
# it again. The same trap the gpg socket directory had.
allow android_tools_t user_tmp_t:file create;

# The wireless half: adb reaches the phone over TCP (192.168.1.110 -> the phone's port), and
# those packets carry this box own dynamic_packet_t - the type the network module uses instead
# of leaving dynamically-classified traffic unlabelled.
allow android_tools_t dynamic_packet_t:packet { send recv };

# --- r39: the server could not talk to its own clients ---
#
# Moving adb into this domain broke the wireless half, and the phone was never the problem.
# adb's host side is a client/server protocol over the loopback socket, and every local
# client is a staff_t process: adbtrack holds the device stream and issues the connects, and
# each `adb` command in the session is another client. For a unix socket, read and write are
# checked against the PEER socket's label, which is staff_t, so the server was denied its own
# clients. Measured under enforcing, 20 times in one run:
#
#   avc: denied { read write } for comm="adb" scontext=...android_tools_t
#                              tcontext=...staff_t tclass=unix_stream_socket
#
# Both symptoms follow from it. adbtrack logged "could not open track-devices", so the device
# stream never existed and the wireless transport was never brought up; and a direct
# `adb connect 192.168.1.106:38079` failed with
#   tls_connection.cpp:282 [client]: Handshake failed in SSL_accept/SSL_connect [invalid library (0)]
# without ever reaching adb_tls_set_certificate (auth.cpp:515), the step that fetches the key
# and presents the certificate. The phone simply closed a handshake that never presented one.
#
# What ruled out the alternatives, all measured on the same phone and key: the same connect
# succeeds (device listed, Handshake succeeded x2) when this domain is permissive; it also
# succeeds when the server runs as staff_t instead; and the SDK's platform-tools 36.0.0 binary
# fails in this domain while the system 36.0.1 binary fails in it too - so neither the key, nor
# the pairing, nor the adb version is the cause, and "36.0.0 is buggy" was the wrong reading of
# the first trace.
#
# Scope: this is the local IPC that adb's protocol requires, peer-scoped to the session domain.
# It is deliberately not narrowed further here - the tighter form is a domain of its own for
# adbtrack, which is a change to a working user tool rather than to this policy (see ledger).
allow android_tools_t staff_t:unix_stream_socket { getattr read write };
#
# r39b: the same shape one level up. The session's services and terminals run inside a
# screen/tmux session, so an adb started there - the user's own `adb` in a pane - inherits a
# pty whose label is staff_screen_t, and using that descriptor is a check against the PTY's
# domain, not the file's:
#
#   avc: denied { use } for comm="adb" path="/dev/pts/5" scontext=...android_tools_t
#                            tcontext=...staff_screen_t tclass=fd
#
# Without it the client cannot write to the terminal it was started from. One class, one
# permission, and only for the session's screen domain.
allow android_tools_t staff_screen_t:fd use;

# --- r41: 5037 is the server's port, not everyone's ---
#
# Starting an adb server asks the kernel for exactly one thing: name_bind on the port. 5037 is
# adb_port_t, and refpolicy declares that type as
#
#	defined_port_type, port_type, unreserved_port_type
#
# which puts it straight under the base policy's
#
#	allow staff_t unreserved_port_type:tcp_socket name_bind
#
# That one attribute grant is why ANY session process can hold 5037 and start a rival server.
# A base rule cannot be taken away - SELinux has no deny - so the lever is the label: 5037 is
# relabelled to this type, which keeps port_type (so every client keeps its name_connect and
# adb from a shell, from tmux or from an IDE is unaffected) but is deliberately NOT in
# unreserved_port_type. The bind is then granted to the server domain alone, and the only way
# to become the server domain is to be adbtrack.
#
# The mapping is applied by this package's pkg_postinst with
#
#	semanage port -m -t adb_server_port_t -p tcp 5037
#
# because a local port mapping outranks the base's portcon for the same port, which a
# module-level portcon does not do predictably. Doing it in the ebuild keeps it reproducible:
# make -C sec-policy/selinux-desktop-home merge reapplies it.
type adb_server_port_t, defined_port_type, port_type;

# The server is android_tools_t - adbtrack execs the adb binary and the child inherits that
# domain - so this single rule is what decides who may start a server. refpolicy's own
# corenet_tcp_bind_adb_port names the old type and no longer applies to this port.
allow android_tools_t adb_server_port_t:tcp_socket name_bind;

# ...and the other half of the same relabel: the CLIENT. android_tools_t reached 5037 through
# unreserved_port_type before, which this type is deliberately not in, so without this line
# every adb command fails with `cannot connect to daemon at tcp:5037: Permission denied` the
# moment the port is relabelled. Clients that run in the session's own domain (staff_t) keep
# their connect for free, because this type stays in port_type - which is exactly why it is
# still a member.
allow android_tools_t adb_server_port_t:tcp_socket name_connect;

# --- r42: adbtrack gets a domain of its own ---
#
# What decides who may start a server is name_bind on adb_server_port_t (r41), and the domain
# that holds it is android_tools_t. So "only the service may start a server" is really "only the
# service may BECOME android_tools_t" - and until now anything in the session could, because
# android_tools_domtrans(staff_t) gives staff_t the transition. A plain `adb start-server` from
# a shell therefore brought up a server in the server's own domain.
#
# adbtrack moves into a domain of its own and keeps the transition; the session's copy goes in
# the next round, once this one is proven to run the service. Until then a session process can
# still start a server, so this is deliberately not the whole change.
#
# The service is a user service: it is exec'd by supervise-daemon in the user's rc session,
# which is staff_t/staff_r, so the transition and the role are both from there.
type adbtrack_t;
type adbtrack_exec_t;
application_domain(adbtrack_t, adbtrack_exec_t)
role staff_r types adbtrack_t;
domtrans_pattern(staff_t, adbtrack_exec_t, adbtrack_t)

# The whole point: the service, and only the service, can become the server domain. refpolicy's
# entry also grants the search and the entrypoint on android_tools_exec_t.
android_tools_domtrans(adbtrack_t)

# NOT removable from here, and that is the whole remaining problem. A live client still runs as
# android_tools_t after the call above was removed, and a self-transition
#
#	type_transition staff_t android_tools_exec_t:process staff_t;
#
# does not cancel it either (it was tried and measured: the client stayed android_tools_t), so
# the base policy's own `android` module wins for this key. Patching that module - or the
# package that owns it - is what "only the service starts a server" still needs; see the ledger
# entry for this round. It is not a rule that can be added here.

# --- what the domain needs, before the permissive window refines it ---
#
# Every line below names a denial from one permissive-window run of the real service, the same
# collection android_tools_t got in r35b. The packet types are granted per domain in this tree,
# not by attribute, so a new domain has to name them.
#
# mDNS, which adbtrack speaks itself (lookup.c): the socket, the howl port, the node bind a
# multicast bind performs, and the packets it sends and receives.
allow adbtrack_t self:udp_socket { create bind setopt read write };
corenet_udp_bind_howl_port(adbtrack_t)
corenet_udp_bind_generic_node(adbtrack_t)
allow adbtrack_t mdns_packet_t:packet { send recv };

# The client connection to the server: loopback TCP, so the socket's own stream permissions,
# name_connect on the relabelled port, and the packet label the secmark ruleset puts on 5037
# traffic - this tree's adb_client_packet_t, not the generic local one.
allow adbtrack_t self:tcp_socket create_stream_socket_perms;
allow adbtrack_t adb_server_port_t:tcp_socket name_connect;
allow adbtrack_t adb_client_packet_t:packet { send recv };

# Locale and zoneinfo, the same pair android_tools_t needed for its log timestamps.
miscfiles_read_localization(adbtrack_t)
files_read_etc_files(adbtrack_t);

# The server side of that connection is read and written by android_tools_t, checked against
# the peer socket's label - the same shape as the staff_t grant in r39, one domain over.
allow android_tools_t adbtrack_t:unix_stream_socket { getattr read write };

# stdio is inherited from supervise-daemon, which is staff_t: using a descriptor that came from
# another domain is an fd check against that domain (r39b is the same denial for a pty).
allow adbtrack_t staff_t:fd use;

# Its log is opened by the supervisor and its scan-backoff file lives in $XDG_RUNTIME_DIR.
allow adbtrack_t user_home_t:file { append getattr lock open read write };
# The runtime ROOT as well as its subdirectories: /run/user/1000 is
# user_runtime_root_t, and reaching $XDG_RUNTIME_DIR/adb-wireless/ needs a search there before
# the directory below it can be created at all. Without it the state file was silently never
# written - one of the few denials in this collection that changes behaviour.
userdom_search_user_runtime_root(adbtrack_t)
allow adbtrack_t user_runtime_t:dir { add_name search write };
allow adbtrack_t user_runtime_t:file { create getattr lock open read write };
