policy_module(desktop.home, 1.0)

gen_require(`
  type auditd_initrc_exec_t;
  type avahi_initrc_exec_t;
  type bluetooth_initrc_exec_t;
  type cgroup_t;
  type chkpwd_t;
  type default_t;
  type device_t;
  type devpts_t;
  type entropyd_initrc_exec_t;
  type initrc_exec_t;
  type initrc_state_t;
  type iptables_initrc_exec_t;
  type local_login_t;
  type nscd_initrc_exec_t;
  type nsfs_t;
  type ntpd_initrc_exec_t;
  type postgresql_initrc_exec_t;
  type shadow_t;
  type ssh_t;
  type staff_bubblewrap_t;
  type staff_dbusd_t;
  type staff_git_t;
  type staff_gkeyringd_t;
  type staff_t;
  type sysadm_screen_t;
  type sysadm_t;
  type sysctl_irq_t;
  type systemd_sessions_runtime_t;
  type tor_initrc_exec_t;
  type user_home_dir_t;
  type user_tmpfs_t;
  type var_lib_t;
  type var_run_t;
  type wtmp_t;
  type xauth_t;
  type xauth_tmp_t;
  type xdg_data_t;
  type xserver_t;
  type xserver_tmpfs_t;
  attribute domain;
  class anon_inode { create getattr map read write };
  class capability { audit_write dac_override dac_read_search net_admin setuid };
  class chr_file { getattr ioctl open read write };
  class dir { add_name create getattr mounton open read remove_name search relabelfrom relabelto };
  class fifo_file { create getattr open read write };
  class file { create getattr map open read unlink write relabelfrom relabelto };
  class io_uring allowed;
  class key create;
  class lnk_file { create read unlink };
  class netlink_generic_socket { bind create getattr read setopt write };
  class process { execmem getcap noatsecure ptrace rlimitinh setexec setsched siginh transition };
  class process2 { nnp_transition nosuid_transition };
  class udp_socket { read write };
  class unix_dgram_socket sendto;
  class unix_stream_socket { getattr ioctl read write };
')

##============= staff_t ==============
allow staff_t domain:process { getcap }; # htop
#allow staff_t auditd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t auditd_t:dir { getattr search }; # pgrep?
#allow staff_t auditd_t:file { open read }; # pgrep?
#allow staff_t avahi_initrc_exec_t:file getattr; # openrc-user
#allow staff_t bluetooth_initrc_exec_t:file getattr; # openrc-user
#allow staff_t cgroup_t:file write; # openrc-user
allow staff_t device_t:fifo_file { getattr open write }; # ckb-next
allow staff_t device_t:fifo_file { getattr open read }; # Kb notify1?
#allow staff_t dhcpc_t:dir { getattr search }; # pgrep?
#allow staff_t dhcpc_t:file { open read }; # pgrep?
#allow staff_t entropyd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t getty_t:dir { getattr search }; # pgrep?
#allow staff_t getty_t:file { open read }; # pgrep?
#allow staff_t initrc_state_t:dir { add_name create getattr open read remove_name search }; # openrc-user
#allow staff_t initrc_state_t:fifo_file { create open read }; # openrc-user
#allow staff_t initrc_state_t:file { create getattr open read unlink write }; # openrc-user
#allow staff_t initrc_state_t:lnk_file { create read unlink }; # openrc-user
#allow staff_t nscd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t ntpd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t self:anon_inode { create map read write }; # MainThread?
#allow staff_t self:capability { audit_write dac_override dac_read_search net_admin setuid }; # openrc-user
#allow staff_t self:capability { dac_override dac_read_search setuid }; # fusermount3
allow staff_t self:netlink_generic_socket { bind create getattr read setopt write }; # i3status
#allow staff_t self:process setexec; # openrc-user
##!!!! This avc can be allowed using the boolean 'allow_execmem'
#allow staff_t self:process execmem; # MainThread?
#allow staff_t sshd_t:dir { getattr search }; # pgrep?
#allow staff_t sshd_t:file { open read }; # pgrep?
dontaudit staff_t staff_dbusd_t:process { noatsecure rlimitinh siginh };
#allow staff_t sysadm_t:dir { getattr search }; # pgrep?
#allow staff_t sysadm_t:file { open read }; # pgrep?
#allow staff_t sysadm_t:key create; # openrc-user
#allow staff_t sysadm_t:process { transition }; # openrc-user
#allow staff_t system_dbusd_t:dir { getattr search }; # pgrep?
#allow staff_t system_dbusd_t:file { open read }; # pgrep?
#allow staff_t systemd_logind_t:dir { getattr search }; # pgrep?
#allow staff_t systemd_logind_t:file { open read }; # pgrep?
#allow staff_t tor_initrc_exec_t:file getattr; # openrc-user
#allow staff_t udev_t:dir { getattr search }; # openrc-user
#allow staff_t unreserved_port_t:tcp_socket name_bind; # MainThread?
#allow staff_t user_tmp_t:dir mounton; # 6757365206D61696E6C6F6F7?!
allow staff_t var_lib_t:file map; # ckb-next
#allow staff_t var_run_t:file { create getattr open write }; # openrc-user
#allow staff_t xserver_t:dir { getattr search }; # pgrep?
allow staff_t xserver_t:unix_dgram_socket { sendto recvfrom }; # ckb-next
##!!!! This avc can be allowed using one of the these booleans:
##     allow_write_xshm, xserver_client_writes_xserver_tmpfs
allow staff_t xserver_tmpfs_t:file write; # ckb-next
#alsa_read_lib(staff_t) # i3status
#auth_rw_lastlog(staff_t) # openrc-user
#auth_tunable_read_shadow(staff_t) # openrc-user
#auth_write_login_records(staff_t) # openrc-user
#corenet_sendrecv_unlabeled_packets(staff_t) # MainThread?
#corenet_tcp_bind_generic_node(staff_t) # MainThread?
#corenet_udp_bind_howl_port(staff_t) # MainThread?
dev_read_generic_files(staff_t) # ckb-next
files_read_var_lib_symlinks(staff_t) # rofi
# --- staff_t session needs, from captures/ ---

# adb binds a node socket (a privileged bind); 22 denials in one capture.
corenet_tcp_bind_generic_node(staff_t)

# the harness ptrace's its own children and sets the scheduler of the sandbox.
allow staff_t self:process ptrace;
allow staff_t staff_bubblewrap_t:process setsched;

# fuse filesystems from the session (fuse_worker, 22 read + 22 write).
storage_rw_fuse(staff_t)

# --- the bubblewrap sandbox (this session runs inside one) ---

# bwrap builds its sandbox by remounting /proc, /dev/pts, sysfs, bpf, configfs,
# debugfs, tracefs, pstore, efivarfs, binfmt_misc...: ~200 remount denials in
# one capture. If this is denied under enforcing the sandbox cannot be built.
fs_remount_all_fs(staff_bubblewrap_t)

# ...and it needs the controlling pty, plus xdg data links and to read its own
# udp socket.
term_use_ptmx(staff_bubblewrap_t)

# steam's webhelper reads its own crash-dump settings under /tmp.
userdom_read_user_tmp_files(staff_bubblewrap_t)
# /proc/pressure: the sandbox reads pressure-stall info.
kernel_read_psi(staff_bubblewrap_t)
read_lnk_files_pattern(staff_bubblewrap_t, xdg_data_t, xdg_data_t)
allow staff_bubblewrap_t self:udp_socket read;

# java binds an unreserved port for its own services.
corenet_tcp_bind_all_unreserved_ports(staff_t)


# staff_gkeyringd_t is another per-role app domain, and like staff_git_t it gets
# the app's own access but nothing for the user's files: gnome_keyring_home_t
# exists with zero rules for it, so under enforcing the keyring daemon could not
# read the user's keyrings at all. This is refpolicy's interface for it.
gnome_read_keyring_home_files(staff_gkeyringd_t)


# htop and nvtop walk every process's /proc/<pid> directory, and each of those
# directories carries that process's domain label. Without this a user domain
# cannot list all processes, and enforcing would leave htop showing a partial
# process list - one capture has 2979 kernel_t:dir denials from it plus ~2000
# more spread across other domains, making it the single largest real denial
# source on the box. This is the interface for exactly that.
domain_read_all_domains_state(staff_t)

# nvtop does the same walk, but it also follows /proc/<pid>/fd to the sockets
# they point at and getattrs those, which are owned by the process's domain.
# refpolicy blesses the dir/file/lnk_file part above but has no interface for
# the socket classes (domain_getattr_all_domains only covers process), so name
# them. getattr is read-only metadata: it cannot connect, send or receive.
allow staff_t domain:{ tcp_socket udp_socket unix_stream_socket unix_dgram_socket } getattr;
allow staff_t domain:{ netlink_route_socket netlink_kobject_uevent_socket netlink_selinux_socket netlink_generic_socket } getattr;
allow staff_t domain:anon_inode getattr;
# io_uring, and this needs care: the kernel reports two different denials
# against class io_uring, and they behave differently. `getattr` (nvtop statting
# an io_uring fd) is NOT in the policy's class table - declaring it makes
# semodule fail with "Failed to resolve permission getattr", so that one stays
# denied. `allowed`, which the harness itself trips, IS in the table and is
# granted here.
allow staff_t self:io_uring allowed;
#files_rw_runtime_dirs(staff_t) # openrc-user
#fs_create_cgroup_dirs(staff_t) # openrc-user
#fs_mount_fusefs(staff_t) # fusermount3?
#init_read_script_state(staff_t) # openrc-user
#init_script_file_entry_type(staff_t) # openrc-user
#iptables_initrc_domtrans(staff_t) # openrc-user
#kernel_read_state(staff_t) # pgrep?
#kernel_request_load_module(staff_t) # 6757365206D61696E6C6F6F7?!
#locallogin_read_state(staff_t) # pgrep?!
#mount_list_runtime(staff_t)
#mount_rw_runtime_files(staff_t)
#networkmanager_read_state(staff_t) # pgrep
#storage_rw_fuse(staff_t) # 6757365206D61696E6C6F6F7?!
#systemd_write_inherited_logind_sessions_pipes(staff_t) # openrc-user
#term_getattr_unallocated_ttys(staff_t) # pgrep
#udev_read_state(staff_t) # pgrep
#xserver_read_state(staff_t) # pgrep
#xserver_read_xdm_state(staff_t) # pgrep

allow local_login_t chkpwd_t:process { noatsecure rlimitinh siginh };
search_dirs_pattern(local_login_t, default_t, default_t)
allow local_login_t self:capability net_admin;

getattr_files_pattern(staff_t, auditd_initrc_exec_t, auditd_initrc_exec_t)
getattr_files_pattern(staff_t, avahi_initrc_exec_t, avahi_initrc_exec_t)
getattr_files_pattern(staff_t, bluetooth_initrc_exec_t, bluetooth_initrc_exec_t)
allow staff_t cgroup_t:dir { add_name create write };
allow staff_t cgroup_t:file write;
getattr_files_pattern(staff_t, entropyd_initrc_exec_t, entropyd_initrc_exec_t)
allow staff_t initrc_exec_t:file { entrypoint getattr open read };
allow staff_t initrc_state_t:dir { add_name create getattr open read remove_name search };
allow staff_t initrc_state_t:fifo_file create;
allow staff_t initrc_state_t:file { create getattr open read unlink write };
allow staff_t initrc_state_t:lnk_file { create read unlink };
getattr_files_pattern(staff_t, iptables_initrc_exec_t, iptables_initrc_exec_t)
getattr_files_pattern(staff_t, nscd_initrc_exec_t, nscd_initrc_exec_t)
getattr_files_pattern(staff_t, nsfs_t, nsfs_t)
getattr_files_pattern(staff_t, ntpd_initrc_exec_t, ntpd_initrc_exec_t)
getattr_files_pattern(staff_t, postgresql_initrc_exec_t, postgresql_initrc_exec_t)
allow staff_t self:capability { audit_write dac_override dac_read_search net_admin setuid sys_ptrace };
allow staff_t self:process setexec;
# allow staff_t shadow_t:file { getattr open read };  # IMPOSSIBLE: the base
#   policy carries 'neverallow authlogin_typeattr_1 shadow_t:file read' and
#   staff_t is in that attribute - user domains may not read /etc/shadow in
#   refpolicy. With this line the module cannot be linked, so the home package
#   could never be installed; the loaded module has no shadow_t rule at all.
#   Password checks go through PAM/chkpwd_t. See auth_can_read_shadow_passwords()
#   if a domain genuinely needs it.
allow staff_t sysadm_t:key create;
allow staff_t sysadm_t:process { noatsecure rlimitinh siginh transition };
allow staff_t systemd_sessions_runtime_t:fifo_file write;
getattr_files_pattern(staff_t, tor_initrc_exec_t, tor_initrc_exec_t)
allow staff_t var_run_t:dir add_name;
allow staff_t var_run_t:file { create open write };
allow staff_t wtmp_t:file write;
allow staff_t xauth_t:process { noatsecure rlimitinh siginh };
delete_files_pattern(staff_t, xauth_tmp_t, xauth_tmp_t)
allow staff_t xserver_t:process { noatsecure rlimitinh };
allow sysadm_t sysadm_screen_t:process { noatsecure rlimitinh siginh };
allow xauth_t self:unix_dgram_socket create;
read_files_pattern(local_login_t, shadow_t, shadow_t)
allow local_login_t sysadm_t:process { noatsecure rlimitinh siginh };

# steamwebhelper (Steam's CEF) writes to its own UDP socket bound to the mDNS
# multicast address 224.0.0.251:5353 - 39 denials in a two-hour window. It is
# self access on a socket the domain created itself, so it is granted here
# rather than buried in a dontaudit.
allow staff_bubblewrap_t self:udp_socket write;

allow staff_t staff_git_t:process2 { nnp_transition nosuid_transition };
allow staff_t ssh_t:process2 { nnp_transition nosuid_transition };
allow staff_t devpts_t:chr_file { getattr open read write ioctl };
kernel_read_psi(staff_t)

# --- r16: the cheap leftovers, all cosmetic but all real ---
# steamwebhelper statfs's the root fs inside the sandbox and gets nothing; the
# sandbox already has fs_remount_all_fs, so a read-only statfs is within scope.
fs_getattr_all_fs(staff_bubblewrap_t)
# uptime/w count sessions from /run/systemd/sessions/<id>; refpolicy has no
# interface for that file, so a raw read.
read_files_pattern(staff_t, systemd_sessions_runtime_t, systemd_sessions_runtime_t)
# admin tooling (sudo git / ss / ls) ioctl'ing a socket the session owns
allow sysadm_t staff_t:unix_stream_socket ioctl;


# --- r20d: the two live gaps in the session's own domain ---
#
# Both were running AVCs when this was written, not hypotheticals.
#
# 1. execmem. `comm="C2 CompilerThread"` (JIT compiler thread) in staff_t - the
#    JVM inside nuvio's AppImage, which runs in the session's domain rather than
#    java_t. java_t has had this since r16; without it for staff_t the JVM fails
#    the moment enforcement comes on, and the DSH agent's own node runtime is in
#    the same domain. A deliberate W^X relaxation for the session, recorded as
#    such rather than granted quietly.
allow staff_t self:process execmem;
# 2. files created directly in the home directory. A new file there inherits the
#    home *directory* type, and staff_t could not read or write it (a tool's
#    settings file). The narrower fix would be a type_transition so new home files
#    land as user_home_t; this is the pragmatic one.
allow staff_t user_home_dir_t:file { getattr read write };
# the user tmpfs, where Gradle's extracted native libraries get mapped
allow staff_t user_tmpfs_t:file { execute execute_no_trans };
# `find` walking /proc/sys/kernel/irq (list_dirs_pattern's perms were missing)
list_dirs_pattern(staff_t, sysctl_irq_t, sysctl_irq_t);
# git reading ~/.local/share
search_dirs_pattern(staff_git_t, xdg_data_t, xdg_data_t)
read_lnk_files_pattern(staff_git_t, xdg_data_t, xdg_data_t)
