policy_module(desktop.home, 1.0)

gen_require(`
  type auditd_initrc_exec_t;
  type avahi_initrc_exec_t;
  type bluetooth_initrc_exec_t;
  type cgroup_t;
  type device_t;
  type devpts_t;
  type entropyd_initrc_exec_t;
  type initrc_exec_t;
  type initrc_state_t;
  type iptables_initrc_exec_t;
  type nscd_initrc_exec_t;
  type nsfs_t;
  type ntpd_initrc_exec_t;
  type postgresql_initrc_exec_t;
  type staff_dbusd_t;
  type staff_t;
  type sysadm_t;
  type sysctl_irq_t;
  type tor_initrc_exec_t;
  type user_home_dir_t;
  type user_tmpfs_t;
  type var_lib_t;
  type var_run_t;
  type wtmp_t;
  type xauth_t;
  type xauth_tmp_t;
  type xserver_t;
  type xserver_tmpfs_t;
  attribute domain;
  class anon_inode { create getattr map read write };
  class capability { audit_write chown dac_override dac_read_search net_admin setuid sys_admin sys_ptrace sys_tty_config };
  class chr_file { getattr ioctl map open read write };
  class dir { add_name create getattr mounton open read relabelfrom relabelto remove_name search watch write };
  class fifo_file { create getattr ioctl open read unlink write };
  class file { create execute getattr link lock map open read relabelfrom relabelto unlink watch write };
  class io_uring { allowed };
  class key { create };
  class lnk_file { create getattr read unlink };
  class netlink_generic_socket { bind create getattr read setopt write };
  class process { execmem getcap getsched noatsecure ptrace rlimitinh setexec setsched siginh sigkill transition };
  class unix_dgram_socket { connect create getattr ioctl sendto };
')

##============= staff_t ==============
allow staff_t domain:process { getcap }; # htop
#allow staff_t auditd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t auditd_t:dir { getattr search }; # pgrep?
#allow staff_t auditd_t:file { open read }; # pgrep?
#allow staff_t avahi_initrc_exec_t:file getattr; # openrc-user
#allow staff_t bluetooth_initrc_exec_t:file getattr; # openrc-user
#allow staff_t cgroup_t:file write; # openrc-user
allow staff_t device_t:fifo_file { getattr open write }; # ckb-next
allow staff_t device_t:fifo_file { getattr open read }; # Kb notify1?
#allow staff_t dhcpc_t:dir { getattr search }; # pgrep?
#allow staff_t dhcpc_t:file { open read }; # pgrep?
#allow staff_t entropyd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t getty_t:dir { getattr search }; # pgrep?
#allow staff_t getty_t:file { open read }; # pgrep?
#allow staff_t initrc_state_t:dir { add_name create getattr open read remove_name search }; # openrc-user
#allow staff_t initrc_state_t:fifo_file { create open read }; # openrc-user
#allow staff_t initrc_state_t:file { create getattr open read unlink write }; # openrc-user
#allow staff_t initrc_state_t:lnk_file { create read unlink }; # openrc-user
#allow staff_t nscd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t ntpd_initrc_exec_t:file getattr; # openrc-user
#allow staff_t self:anon_inode { create map read write }; # MainThread?
#allow staff_t self:capability { audit_write dac_override dac_read_search net_admin setuid }; # openrc-user
#allow staff_t self:capability { dac_override dac_read_search setuid }; # fusermount3
allow staff_t self:netlink_generic_socket { bind create getattr read setopt write }; # i3status
#allow staff_t self:process setexec; # openrc-user
##!!!! This avc can be allowed using the boolean 'allow_execmem'
#allow staff_t self:process execmem; # MainThread?
#allow staff_t sshd_t:dir { getattr search }; # pgrep?
#allow staff_t sshd_t:file { open read }; # pgrep?
dontaudit staff_t staff_dbusd_t:process { noatsecure rlimitinh siginh };
#allow staff_t sysadm_t:dir { getattr search }; # pgrep?
#allow staff_t sysadm_t:file { open read }; # pgrep?
#allow staff_t sysadm_t:key create; # openrc-user
#allow staff_t sysadm_t:process { transition }; # openrc-user
#allow staff_t system_dbusd_t:dir { getattr search }; # pgrep?
#allow staff_t system_dbusd_t:file { open read }; # pgrep?
#allow staff_t systemd_logind_t:dir { getattr search }; # pgrep?
#allow staff_t systemd_logind_t:file { open read }; # pgrep?
#allow staff_t tor_initrc_exec_t:file getattr; # openrc-user
#allow staff_t udev_t:dir { getattr search }; # openrc-user
#allow staff_t unreserved_port_t:tcp_socket name_bind; # MainThread?
#allow staff_t user_tmp_t:dir mounton; # 6757365206D61696E6C6F6F7?!
allow staff_t var_lib_t:file map; # ckb-next
#allow staff_t var_run_t:file { create getattr open write }; # openrc-user
#allow staff_t xserver_t:dir { getattr search }; # pgrep?
allow staff_t xserver_t:unix_dgram_socket { sendto recvfrom }; # ckb-next
##!!!! This avc can be allowed using one of the these booleans:
##     allow_write_xshm, xserver_client_writes_xserver_tmpfs
allow staff_t xserver_tmpfs_t:file write; # ckb-next
#alsa_read_lib(staff_t) # i3status
#auth_rw_lastlog(staff_t) # openrc-user
#auth_tunable_read_shadow(staff_t) # openrc-user
#auth_write_login_records(staff_t) # openrc-user
#corenet_sendrecv_unlabeled_packets(staff_t) # MainThread?
#corenet_tcp_bind_generic_node(staff_t) # MainThread?
#corenet_udp_bind_howl_port(staff_t) # MainThread?
dev_read_generic_files(staff_t) # ckb-next
files_read_var_lib_symlinks(staff_t) # rofi
# --- staff_t session needs, from captures/ ---

# adb binds a node socket (a privileged bind); 22 denials in one capture.
corenet_tcp_bind_generic_node(staff_t)

# the harness ptrace's its own children and sets the scheduler of the sandbox.
allow staff_t self:process ptrace;

# fuse filesystems from the session (fuse_worker, 22 read + 22 write).
storage_rw_fuse(staff_t)


# java binds an unreserved port for its own services.
corenet_tcp_bind_all_unreserved_ports(staff_t)


# htop and nvtop walk every process's /proc/<pid> directory, and each of those
# directories carries that process's domain label. Without this a user domain
# cannot list all processes, and enforcing would leave htop showing a partial
# process list - one capture has 2979 kernel_t:dir denials from it plus ~2000
# more spread across other domains, making it the single largest real denial
# source on the box. This is the interface for exactly that.
domain_read_all_domains_state(staff_t)

# nvtop does the same walk, but it also follows /proc/<pid>/fd to the sockets
# they point at and getattrs those, which are owned by the process's domain.
# refpolicy blesses the dir/file/lnk_file part above but has no interface for
# the socket classes (domain_getattr_all_domains only covers process), so name
# them. getattr is read-only metadata: it cannot connect, send or receive.
allow staff_t domain:{ tcp_socket udp_socket unix_stream_socket unix_dgram_socket } getattr;
allow staff_t domain:{ netlink_route_socket netlink_kobject_uevent_socket netlink_selinux_socket netlink_generic_socket } getattr;
allow staff_t domain:anon_inode getattr;
# io_uring, and this needs care: the kernel reports two different denials
# against class io_uring, and they behave differently. `getattr` (nvtop statting
# an io_uring fd) is NOT in the policy's class table - declaring it makes
# semodule fail with "Failed to resolve permission getattr", so that one stays
# denied. `allowed`, which the harness itself trips, IS in the table and is
# granted here.
allow staff_t self:io_uring allowed;
