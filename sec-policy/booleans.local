# Local boolean settings for this box - the values the shipped policy defaults
# do NOT give us. Like fcontexts.local these live outside the module store
# (booleans are settings, not rules), so the repo records them with the command
# that reapplies them after a store rebuild.
#
#   nginx_enable_http_server   (module default: off)
#
#     nginx binds :80 on 127.0.0.1 and on the two LAN addresses, so it is an
#     http server in the sense the refpolicy nginx module means. With the
#     boolean off, `allow nginx_t http_port_t:tcp_socket name_bind` is inactive
#     and the master dies during startup with
#
#         bind() to 0.0.0.0:80 failed (13: Permission denied)
#
#     which is exactly what happened on the 2026-10-03 enforcing boot (the AVC
#     is at 13:45:34 in the permissive re-test). This is a *persistent* setting,
#     so it is the one line of policy state that a rebuild would otherwise
#     quietly reset.
#
#     Only this one is needed. nginx_can_network_connect stays OFF on purpose:
#     the only thing nginx connects to is the auth gate on :8080, which is
#     http_cache_port_t and is allowed unconditionally, and leaving the boolean
#     off keeps nginx from reaching arbitrary remote ports.
#
# Reapply after a store rebuild with:
#
#   setsebool -P nginx_enable_http_server on
#
nginx_enable_http_server on

#   gpg_manage_generic_user_content   (module default: off)
#
#     The Proton Bridge's pass keychain needs gpg to CREATE entries in the user's
#     password store: `pass insert` runs `gpg -e -r <key> -o
#     ~/.password-store/<entry>.gpg`, i.e. writing a new file into a user_home_t
#     directory. With the boolean off, gpg_t has only the read side
#     (gpg_read_generic_user_content is on) and the write is refused:
#
#         denied { write } comm="gpg2" path="/home/user/.password-store/.../YnJpZGdlL2NoZWNr/"
#         scontext=staff_u:staff_r:gpg_t tcontext=staff_u:object_r:user_home_t tclass=dir
#
#     gpg then reports `can't create '.../check.gpg': Permission denied`, and the
#     bridge logs "no keychain" and serves its vault insecure="true".
#
#     This is refpolicy's own gate for exactly that generic class, and the narrower of
#     its two: gpg_t gets manage rights on user_home_t only, and the whole class is
#     covered by one flip because the dir and file permissions live in the same
#     conditional - there is no second denial waiting behind the first. It gives the
#     user's own gpg no privilege the user lacks (same uid, same files); it unblocks
#     the tool the user invoked.
#
#     gpg_manage_all_user_content stays OFF on purpose: it would extend the same manage
#     rights to every typed home-content label (mozilla_home_t, xdg_*, app stores),
#     which is the blanket grant this policy exists to avoid.
#
#     Reapply after a store rebuild with:
#
#       setsebool -P gpg_manage_generic_user_content on
#
gpg_manage_generic_user_content on
