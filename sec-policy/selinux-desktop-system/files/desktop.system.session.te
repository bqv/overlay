policy_module(desktop.system.session, 1.0)

gen_require(`
  type chkpwd_t;
  type device_t;
  type initrc_state_t;
  type kvm_device_t;
  type lastlog_t;
  type pipewire_t;
  type policykit_t;
  type proc_psi_t;
  type rc_exec_t;
  type rtkit_daemon_t;
  type staff_bubblewrap_t;
  type staff_t;
  type sysadm_t;
  type sysctl_modprobe_t;
  type system_dbusd_t;
  type systemd_logind_t;
  type systemd_sessions_runtime_t;
  type tmpfiles_t;
  type udev_t;
  type user_bin_t;
  type user_runtime_t;
  type utempter_t;
  type var_lib_t;
  type var_run_t;
  type wireplumber_t;
  type xauth_t;
  type xdg_data_t;
  class capability { dac_override dac_read_search net_admin sys_admin sys_ptrace sys_tty_config };
  class chr_file map;
  class dir { create getattr open read relabelfrom relabelto search };
  class fd use;
  class fifo_file { getattr ioctl open read unlink write };
  class file { create getattr map open read relabelfrom relabelto unlink write };
  class lnk_file { create getattr read unlink };
  class process { getcap noatsecure rlimitinh setexec siginh transition };
  class udp_socket { getattr node_bind };
  class unix_dgram_socket { create getattr ioctl sendto };
  class unix_stream_socket { getattr ioctl read write };
  type default_t;
  type local_login_t;
  type shadow_t;
')

# The user OpenRC session: PAM, pam_openrc, the runlevel engine and its state.
#
# The arc r21 to r28 - /run/openrc state, the supervise control channel, executing the
# runlevel engine - plus the login's session services (logind, the buses, PolicyKit, X
# authority, utempter, rtkit) and chkpwd, the PAM helper.
#
# Method and evidence: the local TRIAGE ledger, which is kept out of this repository.

# sesh: the session helper talks to the user's session sockets.
allow sysadm_t staff_t:unix_stream_socket { read write };

# --- r21: the enforcing boot's findings (system side) ---
# xdg-desktop-portal watching the flatpak export share, 335 denials at boot;
# files_watch_all_dirs would cover every directory, so this stays narrow.
allow staff_t var_lib_t:dir watch;
# executing a user-installed binary out of ~/.local/share
allow staff_t xdg_data_t:file execute;
# nvidia-modprobe's /dev/nvidia* fallback: broad capability, but SELinux still
# type-checks every operation it enables, and udev creates the nodes at boot regardless.
allow staff_t self:capability sys_admin;
# systemd-tmpfiles checkpath at boot
allow tmpfiles_t self:capability { dac_override dac_read_search sys_tty_config };
# rtkit asking the audio servers for realtime scheduling
allow rtkit_daemon_t pipewire_t:process setsched;
allow rtkit_daemon_t wireplumber_t:process setsched;

# --- r23: the last live finding from the enforcing boot (system side) ---
# GLib's monitors watch /run/user/1000 (user_runtime_t); refpolicy has no watch interface for it.
allow staff_t user_runtime_t:dir watch;

# --- r24: the 2026-10-03 enforcing boot, second pass ---
# supervise-daemon writing session state into /run, udev reading the seat file, xauth's dgram socket, the DSH sandbox's ~/bin symlink.
allow xauth_t self:unix_dgram_socket ioctl;
allow staff_bubblewrap_t user_bin_t:lnk_file read;

# --- r25: the 2026-10-03 enforcing boot, third pass (the 14:31 boot) ---
# the supervise control fifo: 844 `read` denials on /run/openrc/supervise-user.branch.ctl;
# without it the session's services did not come up.
allow staff_t initrc_state_t:dir { write add_name remove_name rmdir relabelfrom setattr };
allow staff_t initrc_state_t:file { create getattr open read unlink write };
allow staff_t initrc_state_t:fifo_file { getattr ioctl open read unlink write };
allow staff_t var_run_t:dir { write remove_name };
# the session init dropping to the user, and the login record it keeps
allow staff_t self:capability { setgid chown };
allow staff_t lastlog_t:file { getattr lock open read write };
# nvidia-modprobe creating /dev/nvidia-caps
allow staff_t device_t:dir add_name;
# r21b granted `read` on the modprobe sysctl; the session opens it as well
allow staff_t sysctl_modprobe_t:file open;
# nginx's run directory is NOT granted here on purpose: the fault was that /run/nginx
# carried no label of its own, fixed by one file-context line (nginx_runtime_t). See the local TRIAGE ledger (not in this repository).
# udev opens the seat file it already reads
allow udev_t systemd_sessions_runtime_t:file { getattr open read };

# --- r26: the 16:04 boot, the one where the session got as far as PAM ---
# checkpath's relabelfrom on /run/openrc/user is left denied on purpose: the context is
# already right, cross-user relabel is what UBAC stops, and can_change_object_identity
# for staff_t would be a bad trade. What is needed is retiring the supervise pid file.
allow staff_t var_run_t:file unlink;

# --- r28: staff_t could not execute /sbin/openrc (rc_exec_t, upstream grant missing):
# the runlevel engine died with EACCES (rc 126, no AVC) and the whole user runlevel was skipped.
allow staff_t rc_exec_t:file { execute execute_no_trans getattr ioctl lock map open read };

# checkpath -d -m 0700 -o branch:root /run/openrc/user/branch
# uid 0 in the *user's* domain, so the chown needs CAP_FOWNER; the login-time fowner AVC.
allow staff_t self:capability fowner;

# Emulator/KVM: /dev/kvm is kvm_device_t at 0666 and staff_t was denied entirely - the
# emulator probed it 493 times in 85 min. refpolicy has no interface, so raw rw_chr_file_perms.
allow staff_t kvm_device_t:chr_file rw_chr_file_perms;

# Emulator/SwiftShader: its render thread's JIT mprotects a heap page to R+X, which
# SELinux calls execheap. staff_t holds execmem unconditionally but not this, so the
# page never became executable and qemu's RenderThread took SIGSEGV 0-10 ms later:
# 186 deaths, 186 execheap AVCs, 183 ANOM_ABEND sig=11, same pid, 1:1 (TRIAGE 2026-10-03).
allow staff_t self:process execheap;

selinux_getattr_fs(policykit_t)
seutil_search_default_contexts(policykit_t)

systemd_read_logind_state(proc_psi_t)

dontaudit system_dbusd_t policykit_t:process { noatsecure rlimitinh siginh };
dontaudit system_dbusd_t rtkit_daemon_t:process { noatsecure rlimitinh siginh };
dontaudit system_dbusd_t systemd_logind_t:process { noatsecure rlimitinh siginh };
dev_rw_dri(system_dbusd_t)
dev_rw_input_dev(system_dbusd_t)

allow systemd_logind_t self:capability net_admin;
allow systemd_logind_t staff_t:fd use;
kernel_getattr_proc(systemd_logind_t)
ssh_use_sshd_pidfds(systemd_logind_t)
xserver_use_xdm_fds(systemd_logind_t)

allow utempter_t staff_t:udp_socket { read write };

# logind watches a cgroup file (fs_watch_cgroup_files is the interface for it).
fs_watch_cgroup_files(systemd_logind_t)

fs_getattr_tmpfs(xauth_t)
userdom_manage_user_tmp_files(xauth_t)

# r21b: udev checks the session runtime directory (rest of that batch:
# see desktop.system.nginx.te).
allow udev_t systemd_sessions_runtime_t:dir search;
term_use_ptmx(utempter_t)

# chkpwd is the PAM helper; it reads the kernel command line and /proc.
kernel_getattr_proc(chkpwd_t)
kernel_read_kernel_sysctls(chkpwd_t)

# Appended from sec-policy/selinux-desktop-home (files/desktop.home.te).
# The receiving module's gen_require block is NOT included or altered here.

# staff_bubblewrap_t: the session sandbox. This module already owns that domain
# (type staff_bubblewrap_t in its gen_require, and "allow staff_bubblewrap_t
# user_bin_t:lnk_file read;" behind it), so the sandbox building itself and the
# sockets it owns belong here, not in the home package.
# NOTE: the home line for the setsched rule also carried a comment that explains
# the session's own ptrace rule, which stays in the home base, so that comment is
# not reproduced here (see report.txt, comment policy).
allow staff_t staff_bubblewrap_t:process setsched;
# --- the bubblewrap sandbox (this session runs inside one) ---
# bwrap builds its sandbox by remounting /proc, /dev/pts, sysfs, bpf, configfs,
# debugfs, tracefs, pstore, efivarfs, binfmt_misc...: ~200 remount denials in
# one capture. If this is denied under enforcing the sandbox cannot be built.
fs_remount_all_fs(staff_bubblewrap_t)
# ...and it needs the controlling pty, plus xdg data links and to read its own
# udp socket.
term_use_ptmx(staff_bubblewrap_t)
# steam's webhelper reads its own crash-dump settings under /tmp.
userdom_read_user_tmp_files(staff_bubblewrap_t)
# /proc/pressure: the sandbox reads pressure-stall info.
kernel_read_psi(staff_bubblewrap_t)
read_lnk_files_pattern(staff_bubblewrap_t, xdg_data_t, xdg_data_t)
allow staff_bubblewrap_t self:udp_socket read;
# steamwebhelper (Steam's CEF) writes to its own UDP socket bound to the mDNS
# multicast address 224.0.0.251:5353 - 39 denials in a two-hour window. It is
# self access on a socket the domain created itself, so it is granted here
# rather than buried in a dontaudit.
allow staff_bubblewrap_t self:udp_socket write;
# --- r16: the cheap leftovers, all cosmetic but all real ---
# steamwebhelper statfs's the root fs inside the sandbox and gets nothing; the
# sandbox already has fs_remount_all_fs, so a read-only statfs is within scope.
fs_getattr_all_fs(staff_bubblewrap_t)

# local_login_t: PAM/login policy. This module owns the user session's PAM and
# runlevel machinery (chkpwd_t is already in its gen_require), and none of this
# concerns the user's home content.
allow local_login_t chkpwd_t:process { noatsecure rlimitinh siginh };
search_dirs_pattern(local_login_t, default_t, default_t)
allow local_login_t self:capability net_admin;
read_files_pattern(local_login_t, shadow_t, shadow_t)
allow local_login_t sysadm_t:process { noatsecure rlimitinh siginh };

# xauth_t: this module already declares xauth_t and owns the X authority socket
# policy ("allow xauth_t self:unix_dgram_socket ioctl;"), so the create
# permission on the same socket belongs beside it.
allow xauth_t self:unix_dgram_socket create;

# systemd_sessions_runtime_t: the session runtime under /run, not home content.
# This module already declares the type and constrains it for udev.
allow staff_t systemd_sessions_runtime_t:fifo_file write;
# uptime/w count sessions from /run/systemd/sessions/<id>; refpolicy has no
# interface for that file, so a raw read.
read_files_pattern(staff_t, systemd_sessions_runtime_t, systemd_sessions_runtime_t)

# sysadm_t -> staff_t unix socket: this module already carries the read/write
# version of this exact pair ("allow sysadm_t staff_t:unix_stream_socket
# { read write };" in the sesh note), so the ioctl permission belongs with it.
# admin tooling (sudo git / ss / ls) ioctl'ing a socket the session owns
allow sysadm_t staff_t:unix_stream_socket ioctl;
