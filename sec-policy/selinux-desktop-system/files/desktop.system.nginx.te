policy_module(desktop.system.nginx, 1.0)

gen_require(`
  type httpd_cache_t;
  type nginx_t;
  class dir { create getattr open read relabelfrom relabelto search };
  class file { create getattr map open read relabelfrom relabelto unlink write };
')

# nginx serving :80 and proxying to the local gate on :8080. Method and evidence: the local TRIAGE ledger, which is kept out of this repository.

# nginx's proxy cache: httpd_cache_t is apache's and its interfaces grant a different mix.
allow nginx_t httpd_cache_t:dir { add_name remove_name search };
allow nginx_t httpd_cache_t:file { create open read unlink write };

# r21b: nginx's cache getattr, from the enforcing boot.
allow nginx_t httpd_cache_t:dir getattr;
