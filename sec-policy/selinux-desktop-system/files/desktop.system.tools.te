policy_module(desktop.system.tools, 1.0)

gen_require(`
  type auditd_log_t;
  type auditd_t;
  type dhcpc_t;
  type iptables_t;
  type portage_ebuild_t;
  type run_init_t;
  type ss_t;
  type unconfined_t;
  type wireplumber_t;
  attribute domain;
  class cap_userns sys_ptrace;
  class capability { chown dac_override dac_read_search net_admin sys_admin sys_ptrace sys_tty_config };
  class netlink_kobject_uevent_socket { getattr sendto };
  class netlink_route_socket { bind create getopt nlmsg_read read setopt write };
  class process { getcap noatsecure rlimitinh setexec siginh transition };
  class udp_socket { getattr node_bind };
')

# The admin tools a session runs: ss (the socket census), nft, the audit log.
#
# `ss -tulpn` walks /proc to map sockets to processes. Where refpolicy has an interface
# it is used; the socket getattrs have none and are raw allows (read-only metadata). See the local TRIAGE ledger (not in this repository).

# --- r18: ss, the socket census ---
# `ss -tulpn`'s /proc walk (17k denials, the largest AVC source) plus raw socket getattrs, which have no interface.
domain_read_all_domains_state(ss_t)
allow ss_t domain:{ tcp_socket udp_socket unix_stream_socket unix_dgram_socket } getattr;
allow ss_t domain:{ netlink_route_socket netlink_kobject_uevent_socket netlink_selinux_socket netlink_generic_socket } getattr;

# --- r18b: what the census and netfilter tools still needed ---
# domain_read_all_domains_state is dir-only, so `ss -p` also needed the process-class companion (113 denials), CAP_SYS_PTRACE, the remaining socket classes and dac_read_search.
domain_getattr_all_domains(ss_t)
allow ss_t self:capability { dac_read_search sys_ptrace };
allow ss_t self:cap_userns sys_ptrace;
allow ss_t domain:{ rawip_socket packet_socket netlink_audit_socket } getattr;

# `sudo nft -f <file>` runs as iptables_t, so loading a ruleset straight out of
# the overlay needs the same repo access staff_sudo_t got.
portage_read_ebuild(iptables_t)
search_dirs_pattern(iptables_t, portage_ebuild_t, portage_ebuild_t)

# the socket census again: two classes it walks that r18/r19 did not name
allow ss_t wireplumber_t:netlink_kobject_uevent_socket getattr;
allow ss_t dhcpc_t:udp_socket getattr;

# reading the audit log, and the same getattr htop needed on auditd.
read_files_pattern(unconfined_t, auditd_log_t, auditd_log_t)
allow unconfined_t auditd_t:process getcap;
# the tools also read the repo they are pointed at
read_files_pattern(iptables_t, portage_ebuild_t, portage_ebuild_t)

# `sudo ss -apn` - all sockets, not just -tulpn - opens a NETLINK_ROUTE socket to
# enumerate. ss_t held only getattr on that class, so it died with "Cannot open netlink
# socket: Permission denied" and printed nothing at all; ss -tulpn was unaffected
# because it never opens one. refpolicy ships no interface for it (the only one that
# mentions the class is systemd_rw_networkd_netlink_route_sockets, for networkd), so
# this is the read half of staff_t's own grant - plain `ss` worked because as staff_r it
# stays in staff_t.
allow ss_t self:netlink_route_socket { bind create getopt nlmsg_read read setopt write };

# run_init starts an init script in its proper domain and chowns the state it hands
# over; the capability class has no interface for this.
allow run_init_t self:capability chown;

# ss -a asks the kernel to autoload the MPTCP diag module (net-pf-16-proto-4-type-44)
# to enumerate mptcp sockets; the autoload is refused and it carries on - the census
# is complete without it (82 tcp, 232 u_str, and 3 mptcp entries in one run). Nothing
# fails, so this is dontaudited rather than granted: loading a module is not something
# a socket census should be able to ask for.
kernel_dontaudit_request_load_module(ss_t)
