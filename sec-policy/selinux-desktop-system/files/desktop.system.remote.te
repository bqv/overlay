policy_module(desktop.system.remote, 1.0)

gen_require(`
  type chkpwd_t;
  type initrc_state_t;
  type portage_tmp_t;
  type ssh_home_t;
  type ssh_t;
  type sshd_t;
  type local_packet_t;
  type dynamic_packet_t;
  type staff_t;
  type sysadm_t;
  type user_home_t;
  type user_tmpfs_t;
  type var_run_t;
  type xdg_config_t;
  class capability { dac_override dac_read_search net_admin sys_admin sys_ptrace sys_tty_config };
  class dir { create getattr open read relabelfrom relabelto search };
  class file { create getattr map open read relabelfrom relabelto unlink write };
  class process { getcap noatsecure rlimitinh setexec siginh transition };
')

# Remote access to this box: sshd, and the ssh client.
#
# sshd is the lockout-critical service, so its rules are one place: /run/openrc state,
# the pty and shadow accesses, and the signal it sends into the session.
#
# Method and evidence: the local TRIAGE ledger, which is kept out of this repository.

# r21b: ssh reads xdg_config.
allow ssh_t xdg_config_t:dir search;
dontaudit sshd_t chkpwd_t:process { noatsecure rlimitinh siginh };
allow sshd_t initrc_state_t:dir read;
#!!!! This avc can be allowed using the boolean 'allow_polyinstantiation'
allow sshd_t self:capability dac_override;
allow sshd_t self:capability net_admin;
allow sshd_t self:process getcap;
dontaudit sshd_t staff_t:process { noatsecure rlimitinh siginh };
dontaudit sshd_t sysadm_t:process { noatsecure rlimitinh siginh };
auth_tunable_read_shadow(sshd_t)
#corenet_sendrecv_unlabeled_packets(staff_t) # mosh - udp port 60001
kernel_getattr_proc(sshd_t)
libs_exec_lib_files(sshd_t)

# sshd is how this box is reached remotely, so these two are lockout-relevant even though
# there are only two denials each in the whole log. See the local TRIAGE ledger (not in this repository).
init_read_script_status_files(sshd_t)
read_files_pattern(sshd_t, var_run_t, var_run_t)

# --- r15: coverage sweep - what is left in the enforcing domains ---
# ssh allocates a pty (sshd's side already granted); four denials, but ssh is how the box is reached.
term_use_ptmx(ssh_t)
# ssh inherited a cwd on the tmpfs mount (~/tmp) and searched it. ssh_t is not
# permissive, so an ssh started from there is denied without this.
search_dirs_pattern(ssh_t, user_tmpfs_t, user_tmpfs_t)

mmap_read_files_pattern(ssh_t, portage_tmp_t, portage_tmp_t)
read_files_pattern(ssh_t, ssh_home_t, ssh_home_t)
search_dirs_pattern(ssh_t, user_home_t, user_home_t)
# sshd is the lockout-critical service: it records its state and signals the
# session's processes. Writing /run state is ordinary daemon behaviour.
allow sshd_t initrc_state_t:file { create unlink write };
allow sshd_t initrc_state_t:dir { add_name remove_name };
read_lnk_files_pattern(sshd_t, initrc_state_t, initrc_state_t)
allow sshd_t var_run_t:file { getattr open };
allow sshd_t staff_t:process signull;

########################################
# NetBird SSH server: loopback packets on the WireGuard path
#
# 57 live denials, all shaped like this:
#   denied { send } for comm="kworker/0:2" saddr=127.0.0.1 src=51820 daddr=127.0.0.1 dest=7
#     netif=lo scontext=system_u:system_r:sshd_t tcontext=local_packet_t
# The source port is netbird WireGuard port and the socket belongs to netbird SSH server, but the
# kernel attributes the packet to sshd_t, and sshd_t had no local_packet_t rule at all. A grant
# against netbird_t would have been a no-op - that one has been in since the module first loaded
# (allow netbird_t local_packet_t:packet { recv send };). Loopback only, so the scope is small.
allow sshd_t local_packet_t:packet { send recv };

# r59: the same mechanism, one packet label over - the WireGuard tunnel.
#
# Measured 2026-10-12 (handed over raw): SSH from zeta to delta over the tunnel timed out while HTTP
# to delta:8080 over the same tunnel worked. The audit repeated this once a second for ~40 s, two
# kworker pids alternating, same tuple:
#
#   avc: denied { send } for comm="kworker/1:2" saddr=192.168.1.110 src=59278 daddr=31.58.214.93
#        dest=51820 netif=eno1 scontext=system_u:system_r:sshd_t tcontext=system_u:object_r:dynamic_packet_t
#        tclass=packet
#
# That is the ENCAPSULATED packet: src=59278 is wireguard's UDP source port on delta, dest=51820 is
# zeta. The kernel's wireguard transmit path runs in a kworker, but the skb still carries the socket
# it came from - sshd's - which is why the check names sshd_t at all. And the tunnel's transport port
# is in neither secmark map, so it falls to the chains' catch-all, dynamic_packet_t, which sshd_t had
# no rule for.
#
# Why HTTP on 8080 worked and SSH did not: the thing serving 8080 here is a staff_t process (the DSH
# gate), and staff_t already holds dynamic_packet_t send and recv; sshd_t did not. nginx_t holds
# neither, which is consistent with the local nginx having been retired from this path.
#
# The wider shape of the fix, and what was deliberately not done: naming 51820 in the secmark maps
# would need a NEW packet type (no existing secmark describes a VPN transport) plus the same grant for
# every domain whose traffic crosses the tunnel - staff_t's gate included - or the working HTTP path
# would break. That is a bigger change than the measured failure needs, and this one line is what the
# domains that already work through the tunnel have. If the tunnel should ever be its own packet class,
# that is the round to plan, not this one.
allow sshd_t dynamic_packet_t:packet { send recv };
