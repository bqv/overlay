policy_module(desktop.system.staff, 1.0)

gen_require(`
  type auditd_log_t;
  type boolean_t;
  type chkpwd_t;
  type device_t;
  type dri_device_t;
  type modules_dep_t;
  type mtrr_device_t;
  type portage_conf_t;
  type portage_db_t;
  type portage_ebuild_t;
  type portage_tmp_t;
  type proc_kcore_t;
  type proc_kmsg_t;
  type proc_mdstat_t;
  type proc_t;
  type security_t;
  type shell_exec_t;
  type ssh_t;
  type staff_dbusd_t;
  type staff_git_t;
  type staff_screen_t;
  type staff_sudo_t;
  type staff_t;
  type sysadm_t;
  type sysctl_irq_t;
  type sysctl_modprobe_t;
  type user_bin_t;
  type user_tmp_t;
  type git_xdg_config_t;
  type user_home_dir_t;
  type user_home_t;
  type user_runtime_t;
  type user_tmpfs_t;
  type usr_t;
  type utempter_t;
  type xdg_config_t;
  attribute domain;
  class chr_file map;
  class dir { create getattr open read relabelfrom relabelto search watch };
  class fifo_file { getattr ioctl open read unlink write };
  class file { create execmod getattr map open read relabelfrom relabelto unlink watch write };
  class filesystem { associate getattr };
  class netlink_generic_socket { bind create getattr read setopt write };
  class netlink_tcpdiag_socket { bind create getattr nlmsg_read read setopt write };
  class process { getcap noatsecure rlimitinh setexec siginh transition };
  class security read_policy;
  class udp_socket { getattr node_bind };
  class unix_dgram_socket { create getattr ioctl sendto };
  class unix_stream_socket { getattr ioctl read write };
  type staff_gkeyringd_t;
  type xdg_data_t;
  class process2 { nnp_transition nosuid_transition };
')

# The session user (staff_t) and the per-role domains refpolicy derives from it.
#
# Each per-role domain - staff_git_t, staff_sudo_t, staff_screen_t, staff_dbusd_t - is
# narrower than staff_t and needs its own grants; what the session machinery needs as
# staff_t is in desktop.system.session.
#
# Method and evidence: the local TRIAGE ledger, which is kept out of this repository.

allow domain staff_t:fifo_file rw_inherited_fifo_file_perms;

# --- r16c: staff_t reading what a user legitimately reads ---
# /usr/src is src_t: refpolicy covers the directory but not the files under it, and a
# developer greps the tree.
files_search_src(staff_t)
read_files_pattern(staff_t, src_t, src_t)
# Querying the installed database as the user (qlist/qcheck/equery/eselect): the file
# read was here, but not `read` on the vdb *directories*, so listing the tree failed
# with "could not open tree: var/db/pkg". portage_read_db is the complete version.
portage_read_db(staff_t)

allow staff_t dri_device_t:chr_file map;
mmap_read_files_pattern(staff_t, portage_tmp_t, portage_tmp_t)
allow staff_t security_t:security read_policy;
allow staff_t self:netlink_generic_socket { read write create getattr bind setopt };
allow staff_t self:process setexec;
allow staff_t user_home_dir_t:dir add_name;
allow staff_t user_home_t:dir { add_name remove_name };
allow staff_t user_home_t:file { read write open };
# the session's own admin tools: rc-service out of xdg_config, portage config, SELinux
# booleans, smartctl, dmesg/htop proc reads, modinfo and ss's tcp-diag socket.
exec_files_pattern(staff_t, xdg_config_t, xdg_config_t)
# ... and the config, including the /etc/portage/make.profile symlink the q tools
# follow: read_files_pattern covered the files but not the link, and qcheck/equery died
# on it. portage_read_config is the complete version.
portage_read_config(staff_t)
read_files_pattern(staff_t, boolean_t, boolean_t)
# NOT granted: smartctl-style raw disk access (fixed_disk_device_t:blk_file read).
# refpolicy carries `neverallow storage_typeattr_1 fixed_disk_device_t (blk_file (read))`
# - a deliberate property, because reading the block device side-steps the filesystem and
# its permissions. Denied on purpose; the supported route is a storage domain. See the local TRIAGE ledger (not in this repository).
read_files_pattern(staff_t, modules_dep_t, modules_dep_t)
getattr_files_pattern(staff_t, proc_kcore_t, proc_kcore_t)
getattr_files_pattern(staff_t, proc_kmsg_t, proc_kmsg_t)
getattr_files_pattern(staff_t, proc_mdstat_t, proc_mdstat_t)
getattr_files_pattern(staff_t, mtrr_device_t, mtrr_device_t)
search_dirs_pattern(staff_t, sysctl_irq_t, sysctl_irq_t)
getattr_dirs_pattern(staff_t, auditd_log_t, auditd_log_t)
allow staff_t proc_t:filesystem associate;
allow staff_t self:netlink_tcpdiag_socket { bind create getattr nlmsg_read read setopt write };
allow staff_t sysadm_t:process signull;

allow staff_dbusd_t self:process getcap;
dontaudit staff_dbusd_t staff_t:process { noatsecure rlimitinh siginh };

# The overlay is portage_ebuild_t, so user tooling that works in it needs traversal: the
# git wrapper reads and searches it, and a tmux session with a cwd there searches it.
portage_read_ebuild(staff_git_t)
# staff_git_t is refpolicy's per-role git domain, but it gets nothing for the user's ~/bin:
# a read-only `git status` in ~/bin/<repo> left ~40 denials. See the local TRIAGE ledger (not in this repository).
userdom_manage_user_bin(staff_git_t)
# git mmaps its index, and no interface grants map on user_bin_t specifically (the map_all
# variant would cover every home content type). One precise allow.
mmap_read_files_pattern(staff_git_t, user_bin_t, user_bin_t)
term_use_ptmx(staff_git_t)
# r23: git reads a file it is handed in /tmp inside the session sandbox, and the private
# tmpfs there is user_tmpfs_t, not user_tmp_t - so userdom_read_user_tmp_files (already
# used for staff_bubblewrap_t) never covered it. Observed as
#   avc: denied { read } comm=git tcontext=user_tmpfs_t tclass=file
# then denied { open }, then denied { getattr } on the same file: reading it needs all
# three, measured one permission at a time rather than guessed.
# from `git hash-object /tmp/m.txt`, and from outside as
#   fatal: could not read log file '/tmp/msg.txt'  (git commit -F /tmp/msg.txt).
# staff_t has the read by attribute membership; the per-role domains do not.
allow staff_git_t user_tmpfs_t:file { getattr open read };
# Reading the overlay as the session user (editing policy, inspecting ebuilds): without it
# the policy cannot be maintained as staff_t under enforcing.
portage_read_ebuild(staff_t)
search_dirs_pattern(staff_screen_t, portage_ebuild_t, portage_ebuild_t)
allow utempter_t sysadm_t:udp_socket { read write };

# --- lockout-risk scan: denials whose subject is a critical service ---
# sudo (staff_sudo_t) only trips the inherited-fd class, which is not a blocked transition.
dontaudit staff_sudo_t chkpwd_t:process { noatsecure rlimitinh siginh };
dontaudit staff_sudo_t sysadm_t:process { noatsecure rlimitinh siginh };
kernel_getattr_proc(staff_sudo_t)

# --- r16: git in the session's no_new_privs context ---
# git's remaining denials once staff_git_t came off the permissive list.
search_dirs_pattern(staff_git_t, user_tmpfs_t, user_tmpfs_t)
# git talks to a socket the session owns (the agent/wrapper socket)
allow staff_git_t staff_t:unix_stream_socket { getattr ioctl read write };
# git's mmap heuristic reads /proc/sys/vm/overcommit_memory
kernel_read_vm_overcommit_sysctl(staff_git_t)
# the wrapper runs shell scripts (hooks/pagers) without a transition
allow staff_git_t shell_exec_t:file { map execute_no_trans };

search_dirs_pattern(staff_dbusd_t, user_home_dir_t, user_home_dir_t)
search_dirs_pattern(staff_dbusd_t, user_home_t, user_home_t)
search_dirs_pattern(staff_dbusd_t, user_runtime_t, user_runtime_t)
mmap_read_files_pattern(staff_screen_t, portage_tmp_t, portage_tmp_t)
search_dirs_pattern(staff_screen_t, user_home_dir_t, user_home_dir_t)
search_dirs_pattern(staff_screen_t, user_home_t, user_home_t)
read_files_pattern(staff_screen_t, user_home_t, user_home_t)
mmap_read_files_pattern(staff_sudo_t, portage_tmp_t, portage_tmp_t)
allow sysadm_t staff_screen_t:process getcap;
# git's wrapper (staff_git_t) runs the shell scripts git needs, talks to the
# session socket, fetches over https and uses its own dgram socket.
corecmd_exec_shell(staff_git_t)
corenet_sendrecv_http_client_packets(staff_git_t)
allow staff_git_t ssh_t:process2 { nnp_transition nosuid_transition };
mmap_exec_files_pattern(staff_git_t, shell_exec_t, shell_exec_t)
# git also executes hooks out of the working tree (core.hooksPath, or any hook kept in the
# checkout): that is user_home_t, and git's X_OK probe failed there.
userdom_exec_user_home_content_files(staff_git_t)
allow staff_git_t self:unix_dgram_socket { create ioctl };

# r21b: the session opens the modprobe sysctl.
allow staff_t sysctl_modprobe_t:file read;
# r21b: ... and writes into a device directory.
allow staff_t device_t:dir write;

# Appended from sec-policy/selinux-desktop-home (files/desktop.home.te).
# The receiving module's gen_require block is NOT included or altered here.

# staff_git_t: this module owns the per-role git domain (type staff_git_t in its
# gen_require, with its git grants further down the file). The nnp transition is
# made by staff_t, but the domain it constrains is staff_git_t. The home file
# carries no note for that line.
allow staff_t staff_git_t:process2 { nnp_transition nosuid_transition };
# git reading ~/.local/share
search_dirs_pattern(staff_git_t, xdg_data_t, xdg_data_t)
read_lnk_files_pattern(staff_git_t, xdg_data_t, xdg_data_t)

# staff_gkeyringd_t: no other module in either package mentions this per-role
# keyring domain, and the home file's own comment groups it with the per-role
# domains ("another per-role app domain, and like staff_git_t"); those live here.
# staff_gkeyringd_t is another per-role app domain, and like staff_git_t it gets
# the app's own access but nothing for the user's files: gnome_keyring_home_t
# exists with zero rules for it, so under enforcing the keyring daemon could not
# read the user's keyrings at all. This is refpolicy's interface for it.
gnome_read_keyring_home_files(staff_gkeyringd_t)

# ssh_t: the nnp transition into the ssh client. This module already carries the
# same permission set for the same target ("allow staff_git_t ssh_t:process2
# { nnp_transition nosuid_transition };"), and its gen_require already declares
# both ssh_t and staff_t. See report.txt for the alternative destination.
allow staff_t ssh_t:process2 { nnp_transition nosuid_transition };

# --- r29: the QML tooling (dsh-native) ---
#
# Two denials, both from a session process doing something ordinary.
#
# dsh-native watches its installed QML for live reload: inotify_add_watch needs the watch
# permission on the file, which is a notification and grants no read at all. The same app
# also runs with --qml /home/user/var/work/dsh-linux/qml, so the home tree gets the same
# treatment - that invocation is in the audit record, not a guess.
#
# Qt's QML engine JITs: it writes a memfd and then mprotects it PROT_READ|PROT_EXEC, which
# SELinux gates with execmod. Here the memfd carries user_tmpfs_t (a session process's
# memfd gets the user's own tmpfs type, unlike pipewire's, which carries plain tmpfs_t), and
# staff_t already had execute and execute_no_trans on it - this only adds the W^X relaxation
# for memory the session itself wrote. The global allow_execmod boolean stays OFF: it would
# grant file_type:file execmod to files_unconfined_type, which is every file type.
# The home tree needs no line here: adding one moved no capability, because staff_t already
# has watch on user_home_t from the userdomain interfaces.
allow staff_t usr_t:file watch;
allow staff_t user_tmpfs_t:file execmod;

# --- r35: adb and USB devices --- moved to its own domain ---
#
# adb was granted the USB watch and device-node write here, for the whole session. It now runs
# in refpolicy's android_tools_t instead (see desktop.home.adb), which already holds the device
# access, so staff_t keeps nothing on /dev/bus/usb: the grant had also covered the nodes
# belonging to the keyboard and mouse.

# --- r36: the mDNS listener adbtrack never got (a silent denial) ---
#
# ~/bin/adbtrack keeps one adb server and the phone's wireless transport alive. It waits in
# poll() on its own mDNS socket as well as on adb's device stream, so a phone that appears
# wakes it instead of waiting out its 30s re-ask. It is the session user's own tool, so it
# runs as staff_t - and staff_t cannot bind the mDNS port. Measured with a bare bind and
# nothing else on the socket:
#
#   bind(0.0.0.0:5353)  -> EACCES            bind(0.0.0.0:40000) -> bound
#   ss -lunp | grep 5353 -> only the adb server (android_tools_t), which holds this grant
#                           for its Openscreen daemon; adbtrack has no listener of its own.
#
# The denial leaves NO audit record: the policy carries
#   dontaudit staff_t defined_port_type:udp_socket name_bind;
# so the symptom is the EACCES alone, which is why a bind test found this and ausearch did
# not. It is the gpg/git lesson again: ask sesearch --dontaudit before believing "no denial".
#
# corenet_udp_bind_howl_port is refpolicy's interface for exactly this one permission
# (allow $1 howl_port_t:udp_socket name_bind), so nothing generic is opened up. The grant is
# to staff_t as a whole, not to adbtrack alone; that is accepted because it is a port label
# only - bind, with no read or write on the socket - and the port is held by the adb server
# already. Capability delta: one row, staff_t howl_port_t:udp_socket name_bind.
corenet_udp_bind_howl_port(staff_t)

# --- r45: sudo -n with a path inside ~/bin ---
# The wrapper could not resolve anything under ~/bin, so the bare-path form failed with a
# misleading "command not found" while the interpreter form (sudo -n sh <path>) worked. Measured
# with one permissive window on staff_sudo_t and the real command: exactly two permissions were
# missing, both lookup-side - dir search, and lnk_file read because the entries here are
# symlinks. Nothing is needed on the exec side: no execute denial appears, and the script runs
# as soon as these two are allowed, so the target domain already covers running it.
# "user_bin_t is not an exec_type" constrains the broad exec_type grants for confined domains,
# not root. Same shape as the java_t grant earlier in this tree. Deliberate: it is a convenience
# here, not a security boundary, because sudo on this box was already one "sh" away from the
# same result.
search_dirs_pattern(staff_sudo_t, user_bin_t, user_bin_t)
allow staff_sudo_t user_bin_t:lnk_file read;

# --- r46: the file half of the ~/bin grant, because r45 measured a symlink by mistake ---
# r45's test entry was a symlink to a user_home_t script, so it exercised lnk_file read and
# never touched user_bin_t:file. A REGULAR file in ~/bin needs one more permission, and the
# window says exactly one: sudo stat()s the file before handing it to execve.
#   script probe (a root-owned 0755 script, ran under the window) -> denied { getattr } file
#   binary probe (a copy of /bin/true, rc=0 under the window)     -> denied { getattr } file
# Nothing else appears - no open, no read, no execute, no entrypoint - because the exec itself
# is performed by the target domain, which already has
#   allow sysadm_t user_bin_t:file { execute execute_no_trans };
# so this is deliberately one permission rather than the bin_t-shaped set it superficially
# resembles. Adding execute here would let the WRAPPER run ~/bin content without leaving its
# own domain, which is the wrong shape.
allow staff_sudo_t user_bin_t:file getattr;

# --- r47: git cannot mmap its config, or a git index that lives in /tmp ---
# Two denials from a staff_u session, both map, both on the git domain:
#   staff_git_t -> git_xdg_config_t:file map    (~/.gitconfig)
#   staff_git_t -> user_tmp_t:file map          (the harness's index-XXXX under /tmp)
# Why map is missing: in refpolicy the map permission for git domains sits behind
#   allow git_client_domain user_home_content_type:file map; [ git_client_manage_all_user_home_content ]
# and that boolean is OFF on this box. getsebool says off; sesearch prints [ bool ]:True on that
# rule, which is the conditional's polarity rather than the runtime value - getsebool is the
# authority, and that trap is worth remembering. Enabling the boolean would hand git manage
# rights over ALL user home content, far beyond the need, so these are the narrow rows instead.
# The read/write half of both types is unconditional in refpolicy's git module, so map is the
# only permission missing.
# The tmp half has refpolicy's own one-liner. There is no equivalent macro for a single
# user_home_content_type: userdom_map_user_home_content_files covers user_home_t only, and
# git_xdg_config_t is a different type, hence the explicit row.
userdom_map_user_tmp_files(staff_git_t)
allow staff_git_t git_xdg_config_t:file map;
