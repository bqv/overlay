policy_module(desktop.system.base, 1.0)

gen_require(`
  type device_t;
  type lastlog_t;
  type initrc_runtime_t;
  type staff_bubblewrap_t;
  type systemd_sessions_runtime_t;
  type sysctl_modprobe_t;
  type initrc_exec_t;
  type fonts_t;
  type xserver_tmpfs_t;
  type session_dbusd_runtime_t;
  attribute domain;
  attribute can_change_object_identity;
  type initrc_state_t;
  type dhcpc_t;
  type kmod_t;
  type sshd_t;
  type cgroup_t;
  type system_dbusd_t;
  type dhcpc_script_t;
  type rtkit_daemon_t;
  type xauth_t;
  type staff_dbusd_t;
  type chkpwd_t;
  type sysadm_t;
  type systemd_logind_t;
  type policykit_t;
  type sysadm_screen_t;
  type staff_t;
  type portage_fetch_t;
  type setfiles_t;
  type semanage_store_t;
  type selinux_config_t;
  type shutdown_t;
  type shutdown_exec_t;
  type file_context_t;
  type tracefs_t;
  type load_policy_t;
  type ldconfig_t;
  type portage_sandbox_t;
  type semanage_t;
  type portage_t;
  type policy_config_t;
  type proc_psi_t;
  type ssh_t;
  type user_tmpfs_t;
  type utempter_t;
  type dmesg_t;
  type mount_t;
  type tmpfiles_t;
  type var_lib_t;
  type pipewire_t;
  type xserver_t;
  type udev_t;
  type fsadm_t;
  class filesystem getattr;
  class process { getcap noatsecure rlimitinh setexec siginh transition };
  class fd use;
  class packet relabelto;
  class netlink_tcpdiag_socket { bind create getattr nlmsg_read read setopt write };
  class netlink_kobject_uevent_socket { getattr sendto };
  class blk_file { ioctl open read };
  class security read_policy;
  class filesystem associate;
  class lnk_file { create getattr read unlink };
  class file { create getattr map open read unlink write relabelfrom relabelto };
  class dir { create getattr open read search relabelfrom relabelto };
  class capability { dac_override dac_read_search net_admin sys_admin sys_ptrace sys_tty_config };
  type auditd_log_t;
  type auditd_t;
  type dri_device_t;
  type initrc_t;
  type mozilla_t;
  type node_t;
  type nscd_runtime_t;
  type nsfs_t;
  type portage_tmp_t;
  type security_t;
  type ssh_home_t;
  type unconfined_t;
  type user_home_dir_t;
  type user_home_t;
  type user_runtime_t;
  type user_t;
  class cap_userns sys_ptrace;
  class rawip_socket getattr;
  class packet_socket getattr;
  class netlink_audit_socket getattr;
  class unix_dgram_socket { create getattr ioctl sendto };
  class unix_stream_socket { getattr ioctl read write };
  class chr_file map;
  class fifo_file { getattr ioctl open read unlink write };
  class security read_policy;
  class tcp_socket { getattr name_bind node_bind };
  class udp_socket { getattr node_bind };
  class netlink_route_socket getattr;
  class netlink_kobject_uevent_socket getattr;
  class netlink_selinux_socket getattr;
  class netlink_generic_socket { bind create getattr read setopt write };
  type portage_ebuild_t;
  type staff_screen_t;
  type staff_git_t;
  type init_runtime_t;
  type user_bin_t;
  type staff_sudo_t;
  type user_tmpfs_t;
  type shell_exec_t;
  type alsa_t;
  type init_t;
  type systemd_tmpfiles_t;
  type ss_t;
  type nginx_t;
  type xdg_config_t;
  type proc_t;
  type unlabeled_t;
  type httpd_cache_t;
  type fixed_disk_device_t;
  type portage_conf_t;
  type boolean_t;
  type modules_dep_t;
  type proc_kcore_t;
  type proc_kmsg_t;
  type proc_mdstat_t;
  type sysctl_irq_t;
  type wireplumber_t;
  type mtrr_device_t;
  type usr_t;
  type bin_t;
  type git_home_t;
  type xdg_data_t;
  type iptables_t;
  type portage_db_t;
  type var_run_t;
')

kernel_getattr_proc(chkpwd_t)
kernel_read_kernel_sysctls(chkpwd_t)

kernel_read_kernel_sysctls(dhcpc_script_t)
nscd_read_runtime_files(dhcpc_script_t)
selinux_getattr_fs(dhcpc_script_t)
seutil_search_default_contexts(dhcpc_script_t)

dontaudit dhcpc_t dhcpc_script_t:process { noatsecure rlimitinh siginh };
# r18: the dhcpc_t unlabeled_t grant is gone. It existed because nothing
# labelled the DHCP ports; the ruleset maps 67/68/546/547 now, and the
# lease renewed at 08:16 on 1 Oct - after the labelling - with zero
# dhcpc_t packet denials. Verified by evidence, not by assumption.

term_read_console(dmesg_t)

files_read_default_files(fsadm_t)

dev_rw_generic_chr_files(mount_t)

files_getattr_default_dirs(portage_fetch_t)
corenet_sendrecv_http_client_packets(portage_t) # binhosts
corenet_sendrecv_http_client_packets(portage_sandbox_t)
corenet_tcp_bind_generic_node(portage_t)
corenet_udp_bind_generic_node(portage_t)

sysadm_use_fds(portage_sandbox_t)

fs_list_tmpfs(kmod_t)

selinux_getattr_fs(policykit_t)
seutil_search_default_contexts(policykit_t)

systemd_read_logind_state(proc_psi_t)

allow semanage_t cgroup_t:filesystem getattr;
allow semanage_t file_context_t:file { relabelfrom relabelto };
allow semanage_t load_policy_t:process { noatsecure rlimitinh siginh };
allow semanage_t policy_config_t:file relabelfrom;
allow semanage_t selinux_config_t:file { relabelfrom relabelto };
allow semanage_t semanage_store_t:dir { relabelfrom relabelto };
allow semanage_t semanage_store_t:file { relabelfrom relabelto };
allow semanage_t setfiles_t:process { noatsecure rlimitinh siginh };
dev_getattr_fs(semanage_t)
dev_read_sysfs(semanage_t)
fs_getattr_pstorefs(semanage_t)
fs_getattr_tmpfs(semanage_t)
fs_getattr_xattr_fs(semanage_t)
kernel_getattr_debugfs(semanage_t)
kernel_getattr_proc(semanage_t)
kernel_read_vm_overcommit_sysctl(semanage_t)
seutil_relabelto_bin_policy(semanage_t)
term_getattr_pty_fs(semanage_t)

kernel_getattr_proc(setfiles_t)
kernel_read_unlabeled_state(setfiles_t)
term_read_console(setfiles_t)

allow shutdown_t shutdown_exec_t:file execute_no_trans;

dontaudit sshd_t chkpwd_t:process { noatsecure rlimitinh siginh };
allow sshd_t initrc_state_t:dir read;
#!!!! This avc can be allowed using the boolean 'allow_polyinstantiation'
allow sshd_t self:capability dac_override;
allow sshd_t self:capability net_admin;
allow sshd_t self:process getcap;
dontaudit sshd_t staff_t:process { noatsecure rlimitinh siginh };
dontaudit sshd_t sysadm_t:process { noatsecure rlimitinh siginh };
auth_tunable_read_shadow(sshd_t)
#corenet_sendrecv_unlabeled_packets(staff_t) # mosh - udp port 60001
kernel_getattr_proc(sshd_t)
libs_exec_lib_files(sshd_t)

allow domain staff_t:fifo_file rw_inherited_fifo_file_perms;

allow staff_dbusd_t self:process getcap;
dontaudit staff_dbusd_t staff_t:process { noatsecure rlimitinh siginh };

files_search_default(sysadm_screen_t)

allow sysadm_t domain:process { getcap }; # htop
dontaudit sysadm_t ldconfig_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t portage_fetch_t:process { noatsecure rlimitinh siginh };
allow sysadm_t portage_sandbox_t:process { transition };
dontaudit sysadm_t portage_sandbox_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t portage_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t semanage_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t setfiles_t:process { noatsecure rlimitinh siginh };
allow sysadm_t unlabeled_t:process getattr;
corenet_tcp_bind_generic_node(sysadm_t)
kernel_read_unlabeled_files(sysadm_t) # htop / proc
kernel_manage_unlabeled_symlinks(sysadm_t) # htop / proc

# NOTE: the deleted audit.te draft also carried sysadm_sudo_t rules (chkpwd_t, sysadm_t,
# proc_t:filesystem). sysadm_sudo_t is not a type in this policy - checkmodule fails with
# 'unknown type' - so that type was removed from the policy since the capture, and those
# rules are not recoverable. The rest of the draft landed in this file as dontaudit.

dontaudit system_dbusd_t policykit_t:process { noatsecure rlimitinh siginh };
dontaudit system_dbusd_t rtkit_daemon_t:process { noatsecure rlimitinh siginh };
dontaudit system_dbusd_t systemd_logind_t:process { noatsecure rlimitinh siginh };
dev_rw_dri(system_dbusd_t)
dev_rw_input_dev(system_dbusd_t)

allow systemd_logind_t self:capability net_admin;
allow systemd_logind_t staff_t:fd use;
kernel_getattr_proc(systemd_logind_t)
ssh_use_sshd_pidfds(systemd_logind_t)
xserver_use_xdm_fds(systemd_logind_t)

init_use_fds(tmpfiles_t)
kernel_read_kernel_sysctls(tmpfiles_t)
kernel_read_unlabeled_state(tmpfiles_t)
term_use_console(tmpfiles_t)

allow udev_t self:capability2 perfmon;

allow utempter_t staff_t:udp_socket { read write };

# sesh: the session helper talks to the user's session sockets.
allow sysadm_t staff_t:unix_stream_socket { read write };

# --- so the policy can be maintained under enforcing ---
#
# `make -C <pkg> merge` runs setsebool -P in pkg_postinst, and the audit shows
# semanage_t denied relabelto across the whole policy store - the ebuild's own
# post-install step cannot complete with enforcing on. These are refpolicy's
# interfaces for exactly that, plus the two file types they do not cover.
seutil_manage_module_store(semanage_t)
allow semanage_t file_context_t:file relabelto;
allow semanage_t selinux_config_t:file relabelto;
allow semanage_t tracefs_t:filesystem getattr;

# Those allows still left every relabelto denied, because the block is a
# constraint rather than a missing allow:
#   (constrain (file (create relabelfrom relabelto))
#     (or (eq u1 u2) (eq t1 can_change_object_identity)))
# The store files carry system_u while this runs as staff_u, so eq u1 u2 fails,
# and can_change_object_identity held only kernel_t. Constraints sit above the
# allow rules, so attribute membership is the only way to satisfy it - which is
# exactly what a policy-management domain needs. No neverallow guards it.
typeattribute semanage_t can_change_object_identity;

# Running an ebuild as the admin: `make compile/merge` executes the .ebuild
# file, so sysadm_t needs to read and execute portage_ebuild_t.
portage_read_ebuild(sysadm_t)
can_exec(sysadm_t, portage_ebuild_t)

# The overlay lives under /var/db/repos, whose tree is labelled
# portage_ebuild_t, so ordinary user tooling that works in it needs traversal:
# the user's git wrapper reads and searches it, and a tmux session with a cwd
# there searches it. refpolicy only expects portage tools in that tree.
portage_read_ebuild(staff_git_t)
# staff_git_t is refpolicy's per-role git domain (declared inside an optional
# block in the staff module). It gets git's own access - git_exec_t, git_home_t -
# but nothing for the user's ~/bin, so git cannot work in a repo there, and
# staff_git_t is still in the permissive list. Reproduced with a read-only
# `git status` in ~/bin/<repo>: ~40 denials against user_bin_t plus /dev/ptmx.
userdom_manage_user_bin(staff_git_t)
# git mmaps its index, and no interface grants map on user_bin_t specifically
# (userdom_map_user_home_content_files covers user_home_t only, and the map_all
# variant would grant map on every home content type). One precise allow.
mmap_read_files_pattern(staff_git_t, user_bin_t, user_bin_t)
term_use_ptmx(staff_git_t)
# The overlay itself lives under /var/db/repos, so *reading* it as the session
# user (editing policy files, inspecting ebuilds) needs this too - without it the
# policy cannot be maintained as staff_t under enforcing.
portage_read_ebuild(staff_t)
search_dirs_pattern(staff_screen_t, portage_ebuild_t, portage_ebuild_t)
allow utempter_t sysadm_t:udp_socket { read write };

# --- what enforcement would actually hit in the critical paths ---
#
# These came from scanning for denials whose SUBJECT is a critical service -
# the lockout-risk question rather than the noise question.
#
# sudo (staff_sudo_t) only ever trips the inherited-fd class, which this file
# already dontaudits for other domains: informational, the transition is not
# blocked, so dontaudit is the right treatment rather than a grant. Plus a
# statfs on /proc.
dontaudit staff_sudo_t chkpwd_t:process { noatsecure rlimitinh siginh };
dontaudit staff_sudo_t sysadm_t:process { noatsecure rlimitinh siginh };
kernel_getattr_proc(staff_sudo_t)

# sshd is how this box is reached remotely, so these two are lockout-relevant
# even though there are only two denials each in the whole log: sshd reading
# openrc's script state, and a file under /run.
init_read_script_status_files(sshd_t)
read_files_pattern(sshd_t, var_run_t, var_run_t)

# logind watches a cgroup file (fs_watch_cgroup_files is the interface for it).
fs_watch_cgroup_files(systemd_logind_t)

# dhcpcd-run-hook searches the init runtime directory; refpolicy has no search
# interface for it (only create/delete/dontaudit), so this is a raw allow.
search_dirs_pattern(dhcpc_script_t, init_runtime_t, init_runtime_t)
term_use_ptmx(utempter_t)

fs_getattr_tmpfs(xauth_t)
userdom_manage_user_tmp_files(xauth_t)

# --- r15: coverage sweep - what is left in the enforcing domains ---
#
# A two-hour capture filtered to the *enforcing* domains only (the seven
# permissive domains and my own census tooling excluded as self-inflicted)
# leaves just these. Everything else the box produced was already handled.

# ssh allocates a pty for the session. sshd's side was already granted; this is
# the client, and ssh is how the box is reached remotely - so it matters even
# at four denials.
term_use_ptmx(ssh_t)
# ssh inherited a cwd on the tmpfs mount (~/tmp) and searched it. ssh_t is not
# permissive, so an ssh started from there is denied without this.
search_dirs_pattern(ssh_t, user_tmpfs_t, user_tmpfs_t)

# Running the capture tool and the build through sudo: the obstacle is the repo
# tree being portage_ebuild_t. staff_sudo_t is what a `sudo ./aud` or
# `sudo make -C <pkg> merge` becomes, so without this the policy cannot be
# triaged or maintained under enforcing at all.
portage_read_ebuild(staff_sudo_t)
search_dirs_pattern(staff_sudo_t, portage_ebuild_t, portage_ebuild_t)

# semodule/semanage asking for its own scheduling class during a merge.
allow semanage_t self:process getsched;

# --- r16: git in the session's no_new_privs context ---
# git's remaining denials once staff_git_t came off the permissive list.
search_dirs_pattern(staff_git_t, user_tmpfs_t, user_tmpfs_t)
# git talks to a socket the session owns (the agent/wrapper socket)
allow staff_git_t staff_t:unix_stream_socket { getattr ioctl read write };
# git's mmap heuristic reads /proc/sys/vm/overcommit_memory
kernel_read_vm_overcommit_sysctl(staff_git_t)
# the wrapper runs shell scripts (hooks/pagers) without a transition
allow staff_git_t shell_exec_t:file { map execute_no_trans };

# --- r16b: the boot path ---
#
# /var/log/dmesg holds the boot of the running kernel, and the AVCs in it were
# ENFORCED: the config says enforcing, OpenRC applies it via
# selinux_init_load_policy(), and these all carry permissive=0. So this is the
# only hard evidence of what a real enforcing boot hits - worth clearing, since a
# reboot is now the practical switch.

# modprobe reads /dev/console (4 enforced denials). refpolicy's interface for it,
# the same one dmesg_t already uses.
term_read_console(kmod_t)

# Inherited-fd bookkeeping only. The transition is not blocked and nothing
# fails, which is the one case where dontaudit is right rather than a grant -
# the same class as the 16 already dontaudited in this file.
dontaudit udev_t alsa_t:process { noatsecure rlimitinh siginh };
# systemd-tmpfiles inherits the console fd from init and only loses the ability
# to print to the console. Nothing functional.
dontaudit systemd_tmpfiles_t init_t:fd { use };

# --- r16c: staff_t reading what a user legitimately reads ---
# /usr/src is src_t. refpolicy has files_search_src() for the directory but no
# interface for reading the files under it, and a developer greps the kernel
# tree - so the read is a raw allow.
files_search_src(staff_t)
read_files_pattern(staff_t, src_t, src_t)
# querying the installed-package database (qlist/eselect-style tools)
read_files_pattern(staff_t, portage_db_t, portage_db_t)

# --- r18: ss, the socket census ---
#
# `ss -tulpn` walks /proc/<pid> to map sockets back to the processes that hold
# them, which is the same access htop/nvtop needed - 17k denials in the retained
# logs, the single largest source of AVC noise in the triage windows, and `ss` is
# a normal admin tool rather than something unusual. Same treatment as staff_t:
# the refpolicy interface for the /proc walk, plus raw allows for the socket
# getattrs, because refpolicy has no interface for those (domain_getattr_all_
# domains covers only the process class) and getattr is read-only metadata.
domain_read_all_domains_state(ss_t)
allow ss_t domain:{ tcp_socket udp_socket unix_stream_socket unix_dgram_socket } getattr;
allow ss_t domain:{ netlink_route_socket netlink_kobject_uevent_socket netlink_selinux_socket netlink_generic_socket } getattr;

# --- r18b: what the census and netfilter tools still needed ---
#
# domain_read_all_domains_state is dir-only (kernel_search_proc + domain:dir
# list perms), so `ss -p` still needed the companion interface for the process
# class - 113 denials in one window. The rest is what a root-run census needs:
# CAP_SYS_PTRACE to read other processes' /proc entries, the remaining socket
# classes (rawip/packet/netlink_audit), and dac_read_search.
domain_getattr_all_domains(ss_t)
allow ss_t self:capability { dac_read_search sys_ptrace };
allow ss_t self:cap_userns sys_ptrace;
allow ss_t domain:{ rawip_socket packet_socket netlink_audit_socket } getattr;

# `sudo nft -f <file>` runs as iptables_t, so loading a ruleset straight out of
# the overlay needs the same repo access staff_sudo_t got.
portage_read_ebuild(iptables_t)
search_dirs_pattern(iptables_t, portage_ebuild_t, portage_ebuild_t)

# --- r20b: folded in from the hand-written desktop.system.cil ---
#
# That file was a second source of the same policy: separate from the .te files,
# with its own require list, and it is how the dhcpc_t blanket survived being
# "removed" from desktop.system.base.te in r18 - the .cil still carried a copy.
# One source of truth is worth more than the convenience of a CIL file, and every
# rule in it is an ordinary allow, so they live here now and the module goes away.
getattr_files_pattern(initrc_t, nsfs_t, nsfs_t)
search_dirs_pattern(dhcpc_script_t, nscd_runtime_t, nscd_runtime_t)
allow portage_sandbox_t sysadm_t:fd use;
allow portage_t node_t:tcp_socket node_bind;
allow portage_t node_t:udp_socket node_bind;
mmap_read_files_pattern(ssh_t, portage_tmp_t, portage_tmp_t)
read_files_pattern(ssh_t, ssh_home_t, ssh_home_t)
search_dirs_pattern(ssh_t, user_home_t, user_home_t)
search_dirs_pattern(staff_dbusd_t, user_home_dir_t, user_home_dir_t)
search_dirs_pattern(staff_dbusd_t, user_home_t, user_home_t)
search_dirs_pattern(staff_dbusd_t, user_runtime_t, user_runtime_t)
mmap_read_files_pattern(staff_screen_t, portage_tmp_t, portage_tmp_t)
search_dirs_pattern(staff_screen_t, user_home_dir_t, user_home_dir_t)
search_dirs_pattern(staff_screen_t, user_home_t, user_home_t)
read_files_pattern(staff_screen_t, user_home_t, user_home_t)
mmap_read_files_pattern(staff_sudo_t, portage_tmp_t, portage_tmp_t)
allow staff_t dri_device_t:chr_file map;
mmap_read_files_pattern(staff_t, portage_tmp_t, portage_tmp_t)
allow staff_t security_t:security read_policy;
allow staff_t self:netlink_generic_socket { read write create getattr bind setopt };
allow staff_t self:process setexec;
allow staff_t user_home_dir_t:dir add_name;
allow staff_t user_home_t:dir { add_name remove_name };
allow staff_t user_home_t:file { read write open };
read_files_pattern(sysadm_t, auditd_log_t, auditd_log_t)
allow sysadm_t mozilla_t:process getcap;
getattr_files_pattern(sysadm_t, nsfs_t, nsfs_t)
allow sysadm_t rtkit_daemon_t:process getcap;
allow sysadm_t ssh_t:process getcap;
allow sysadm_t staff_screen_t:process getcap;
allow sysadm_t staff_t:fifo_file write;
allow sysadm_t staff_t:process getcap;
allow sysadm_t system_dbusd_t:process getcap;
allow sysadm_t user_t:process getcap;
read_files_pattern(unconfined_t, auditd_log_t, auditd_log_t)
allow unconfined_t auditd_t:process getcap;

# --- r20c: what the corrected full-log sweep found still missing (part 1) ---
# Every line here answers a specific tuple that the running policy does not allow,
# from a sweep that checks each permission separately.

# THE critical one. nft assigns a secmark to every packet; the first packet of a
# flow has no label yet, so the assignment is a relabelto from unlabeled_t. Only
# packet_type is granted (from the original ruleset), and unlabeled_t is not in
# that attribute - so under enforcing the labelling itself would be denied and
# traffic would stay unlabelled, taking the whole network half with it.
allow iptables_t unlabeled_t:packet relabelto;
# the tools also read the repo they are pointed at
read_files_pattern(iptables_t, portage_ebuild_t, portage_ebuild_t)

# sshd is the lockout-critical service: it records its state and signals the
# session's processes. Writing /run state is ordinary daemon behaviour.
allow sshd_t initrc_state_t:file { create unlink write };
allow sshd_t initrc_state_t:dir { add_name remove_name };
read_lnk_files_pattern(sshd_t, initrc_state_t, initrc_state_t)
allow sshd_t var_run_t:file { getattr open };
allow sshd_t staff_t:process signull;

# nginx's proxy cache. refpolicy keeps httpd_cache_t for the apache module, so
# there is no nginx-specific interface for it; the apache cache interfaces exist
# but grant a different mix, so the perms are written out.
allow nginx_t httpd_cache_t:dir { add_name remove_name search };
allow nginx_t httpd_cache_t:file { create open read unlink write };

# git's wrapper (staff_git_t) runs the shell scripts git needs, talks to the
# session socket, fetches over https and uses its own dgram socket.
corecmd_exec_shell(staff_git_t)
corenet_sendrecv_http_client_packets(staff_git_t)
allow staff_git_t ssh_t:process2 { nnp_transition nosuid_transition };
mmap_exec_files_pattern(staff_git_t, shell_exec_t, shell_exec_t)
allow staff_git_t self:unix_dgram_socket { create ioctl };

# the session's own admin tools: rc-service executing a script out of xdg_config,
# reading the portage config, reading the SELinux booleans, smartctl on the disk,
# dmesg/htop-style proc reads, modinfo, and ss's tcp-diag netlink socket.
exec_files_pattern(staff_t, xdg_config_t, xdg_config_t)
read_files_pattern(staff_t, portage_conf_t, portage_conf_t)
read_files_pattern(staff_t, boolean_t, boolean_t)
# NOT granted: smartctl-style raw disk access (fixed_disk_device_t:blk_file read).
# refpolicy carries `neverallow storage_typeattr_1 fixed_disk_device_t (blk_file
# (read))` - a deliberate property, because reading the block device side-steps
# the filesystem and its permissions. The neverallow check refused the whole
# module until this line was removed, which is the check doing its job (the same
# mechanism as the shadow_t neverallow that was the model case for this work).
# Under enforcing, `smartctl` on the raw disk is denied; that is intended, and
# the supported route would be a storage domain rather than widening staff_t.
read_files_pattern(staff_t, modules_dep_t, modules_dep_t)
getattr_files_pattern(staff_t, proc_kcore_t, proc_kcore_t)
getattr_files_pattern(staff_t, proc_kmsg_t, proc_kmsg_t)
getattr_files_pattern(staff_t, proc_mdstat_t, proc_mdstat_t)
getattr_files_pattern(staff_t, mtrr_device_t, mtrr_device_t)
search_dirs_pattern(staff_t, sysctl_irq_t, sysctl_irq_t)
getattr_dirs_pattern(staff_t, auditd_log_t, auditd_log_t)
allow staff_t proc_t:filesystem associate;
allow staff_t self:netlink_tcpdiag_socket { bind create getattr nlmsg_read read setopt write };
allow staff_t sysadm_t:process signull;

# the socket census again: two classes it walks that r18/r19 did not name
allow ss_t wireplumber_t:netlink_kobject_uevent_socket getattr;
allow ss_t dhcpc_t:udp_socket getattr;

# --- r21: the enforcing boot's findings (system side) ---
#
# The user OpenRC session. staff_t (running as root for the user session) creates
# its state under /run/openrc, which is initrc_state_t - the create was denied and
# THE USER SESSION DID NOT START. refpolicy has read interfaces for that tree but
# none for writing it, so this is raw.
allow staff_t initrc_state_t:dir { write add_name remove_name };
allow staff_t initrc_state_t:file { create getattr open read unlink write };
# xdg-desktop-portal watching the flatpak export share (335 denials at boot).
# files_watch_all_dirs would grant this on every directory; this is narrow.
allow staff_t var_lib_t:dir watch;
# executing a user-installed binary out of ~/.local/share
allow staff_t xdg_data_t:file execute;
# nvidia-modprobe wants CAP_SYS_ADMIN to create the /dev/nvidia* nodes. Broad
# capability, but SELinux still type-checks every privileged operation it enables;
# udev creates the nodes at boot regardless, so this only helps the fallback path.
allow staff_t self:capability sys_admin;
# systemd-tmpfiles checkpath at boot
allow tmpfiles_t self:capability { dac_override dac_read_search sys_tty_config };
# rtkit asking the audio servers for realtime scheduling
allow rtkit_daemon_t pipewire_t:process setsched;
allow rtkit_daemon_t wireplumber_t:process setsched;

# r21b: the last few from the enforcing boot - nginx's cache getattr, udev looking
# at session dirs, ssh reading xdg_config, the session reading the modprobe
# sysctl, and the unconfined entrypoint for an init script.
allow nginx_t httpd_cache_t:dir getattr;
allow udev_t systemd_sessions_runtime_t:dir search;
allow ssh_t xdg_config_t:dir search;
allow staff_t sysctl_modprobe_t:file read;
allow staff_t device_t:dir write;
allow unconfined_t initrc_exec_t:file entrypoint;

# --- r23: the last live finding from the enforcing boot (system side) ---
#
# GLib's file monitors watch /run/user/1000, which is user_runtime_t. refpolicy
# has no watch interface for that type, and `watch` is not under the UBAC
# constraint, so the permission is written out - the same idiom as the var_lib_t
# line above.
allow staff_t user_runtime_t:dir watch;

# --- r24: the 2026-10-03 enforcing boot, second pass ---
#
# supervise-daemon writing the user session's own state straight into /run;
# udev reading the session's seat file; xauth's own dgram socket; and the DSH
# sandbox reading a symlink out of ~/bin, which is how it execs a shell inside
# the sandbox.
allow staff_t var_run_t:dir write;
allow udev_t systemd_sessions_runtime_t:file read;
allow xauth_t self:unix_dgram_socket ioctl;
allow staff_bubblewrap_t user_bin_t:lnk_file read;

# --- r25: the 2026-10-03 enforcing boot, third pass (the 14:31 boot) ---
#
# The user session's own supervise control channel. r21 granted the directory
# and file permissions on initrc_state_t but never the fifo the session
# actually talks through: 844 `read` denials on
# /run/openrc/supervise-user.branch.ctl, plus the unlink that retires it, the
# rmdir/relabelfrom/setattr on the tree above it, and the pid file in /run.
# That, not checkpath, is why the session's services still did not come up on
# this boot.
allow staff_t initrc_state_t:dir { write add_name remove_name rmdir relabelfrom setattr };
allow staff_t initrc_state_t:file { create getattr open read unlink write };
allow staff_t initrc_state_t:fifo_file { getattr ioctl open read unlink write };
allow staff_t var_run_t:dir { write remove_name };
# the session init dropping to the user, and the login record it keeps
allow staff_t self:capability setgid;
allow staff_t lastlog_t:file { read write };
# nvidia-modprobe creating /dev/nvidia-caps
allow staff_t device_t:dir add_name;
# r21b granted `read` on the modprobe sysctl; the session opens it as well
allow staff_t sysctl_modprobe_t:file open;
# nginx's run directory. checkpath creates /run/nginx as initrc_runtime_t -
# refpolicy has no fcontext for the path - and nginx_t could not reach it at
# all, so the master could not write its pid file and exited. `search` alone is
# not enough: creating the file needs add_name and write on the directory, and
# retiring it needs remove_name. The two that were actually missing were found
# only by making nginx_t a permissive *type* (semanage permissive -a nginx_t),
# which allows the operation and still logs it - this box has now produced four
# denials that raise EACCES with no audit record at all, and guessing at them
# costs a boot each time.
allow nginx_t initrc_runtime_t:dir { search add_name remove_name write };
allow nginx_t initrc_runtime_t:file { create getattr open read unlink write };
# udev opens the seat file it already reads
allow udev_t systemd_sessions_runtime_t:file open;
