#!/sbin/nft -f
flush ruleset
table inet filter {
	secmark icmp_server {
		"system_u:object_r:icmp_packet_t:s0"
	}
	secmark ssh_server {
		"system_u:object_r:ssh_server_packet_t:s0"
	}
	secmark ssh_client {
		"system_u:object_r:ssh_client_packet_t:s0"
	}
	secmark http_server {
		"system_u:object_r:http_server_packet_t:s0"
	}
	secmark http_client {
		"system_u:object_r:http_client_packet_t:s0"
	}
	secmark dns_server {
		"system_u:object_r:dns_server_packet_t:s0"
	}
	secmark dns_client {
		"system_u:object_r:dns_client_packet_t:s0"
	}
	secmark mosh_server {
		"system_u:object_r:mosh_packet_t:s0"
	}

	# traffic on ports no map can name (BitTorrent listen ports, WebRTC, odd
	# station ports, ssh on a custom port) - see desktop.system.network.te
	secmark unclassified {
		"system_u:object_r:dynamic_packet_t:s0"
	}
	secmark mdns {
		"system_u:object_r:mdns_packet_t:s0"
	}
	# loopback traffic no port map classifies - see desktop.system.network.te
	secmark local {
		"system_u:object_r:local_packet_t:s0"
	}
	secmark adb_server {
		"system_u:object_r:adb_server_packet_t:s0"
	}
	secmark adb_client {
		"system_u:object_r:adb_client_packet_t:s0"
	}
	secmark dhcp_client {
		"system_u:object_r:dhcpd_client_packet_t:s0"
	}

	# mail and XMPP are normal flows for this box (the mail plugin, Gajim) but the
	# ports were unmapped, so only the per-domain blankes covered them.
	secmark smtp_client {
		"system_u:object_r:smtp_client_packet_t:s0"
	}
	secmark pop_client {
		"system_u:object_r:pop_client_packet_t:s0"
	}
	secmark mail_client {
		"system_u:object_r:mail_client_packet_t:s0"
	}
	secmark jabber_client {
		"system_u:object_r:jabber_client_client_packet_t:s0"
	}

	map secmapping_in {
		type inet_service : secmark
			elements = {\
				22 : "ssh_server",\
				53 : "dns_client",\
				68 : "dhcp_client",\
				80 : "http_server",\
				443 : "http_server",\
				546 : "dhcp_client",\
				5353 : "mdns",\
				5037 : "adb_server",\
				5554 : "adb_server",\
				5555 : "adb_server",\
				11471 : "http_server",\
			}
	}

	map secmapping_out {
		type inet_service : secmark
			elements = {\
				22 : "ssh_client",\
				53 : "dns_client",\
				67 : "dhcp_client",\
				68 : "dhcp_client",\
				80 : "http_client",\
				443 : "http_client",\
				547 : "dhcp_client",\
				5353 : "mdns",\
				5037 : "adb_client",\
				5554 : "adb_client",\
				5555 : "adb_client",\
				60001 : "mosh_server",\
				60002 : "mosh_server",\
				5222 : "jabber_client",\
				5223 : "jabber_client",\
				8080 : "http_client",\
				25 : "smtp_client",\
				465 : "smtp_client",\
				587 : "smtp_client",\
				110 : "pop_client",\
				995 : "pop_client",\
				143 : "mail_client",\
				993 : "mail_client",\
			}
	}

	chain input {
		type filter hook input priority -225; policy accept;

		# 1. an established flow keeps the label its conntrack entry remembers.
		#    A loopback flow was labelled once, by the side that opened it, and
		#    is not re-derived here - the two chains hold different maps and
		#    re-deriving on loopback would make them disagree about one flow.
		ct state established,related meta secmark set ct secmark

		# 2. (no loopback default here on purpose - every loopback packet is
		#    generated locally, so it already passed the output chain and that
		#    chain labelled this same skb. Setting a default here would clobber
		#    the label the output chain derived from the outbound map: the two
		#    maps hold different ports, and :8080 exists in only one of them.)

		# 3. a named label where a port map names one, for off-box flows. A
		#    loopback packet is excluded here for the same reason as step 2:
		#    it was already labelled by the output chain, and the inbound map
		#    would override that with the other side's type (a browser's
		#    loopback flow to :80 would become http_server instead of
		#    http_client, and the browser's next receive would be denied).
		# unclassified inbound keeps a label instead of being left unlabeled
		# 1b. ICMP and ICMPv6 are labelled from the protocol alone, in every
		#     conntrack state - `ct state new` is not enough. Multicast ICMPv6
		#     (router advertisements, neighbour discovery) is often not tracked
		#     at all, and a packet on a flow whose conntrack entry carries no
		#     secmark is labelled *empty* by the line above. That is how dhcpcd
		#     lost the router advertisements - accept_ra=0 here, so dhcpcd is what
		#     keeps the IPv6 address and default route alive - and how a ping
		#     reply came back unlabeled. IPv4 kept working throughout, so it would
		#     have read as an unrelated mystery.
		ip6 nexthdr icmpv6 meta secmark set "icmp_server"
		ip protocol icmp meta secmark set "icmp_server"

		# 1c. any other packet no state guard above reaches
		ct state untracked meta iifname != "lo" meta secmark set "unclassified"
		ct state new meta iifname != "lo" meta secmark set "unclassified"
		ct state new meta iifname != "lo" meta secmark set tcp dport map @secmapping_in
		ct state new meta iifname != "lo" meta secmark set udp dport map @secmapping_in


		iif lo tcp dport 22 ip6 saddr ::1 ip6 daddr ::1 meta secmark set "ssh_server"
		iif lo udp dport 22 ip6 saddr ::1 ip6 daddr ::1 meta secmark set "ssh_server"
		iif lo tcp dport 22 ip saddr 127.0.0.1 ip daddr 127.0.0.1 meta secmark set "ssh_server"
		iif lo udp dport 22 ip saddr 127.0.0.1 ip daddr 127.0.0.1 meta secmark set "ssh_server"

		# 4. repair an off-box flow whose conntrack entry predates these rules:
		#    only the direction that opened it, and never on loopback, so a reply
		#    is never given the other side's label. An unmapped port stays as it
		#    was - unmapped off-box traffic is left unlabeled on purpose.
		ct state established,related ct direction original meta iifname != "lo" meta secmark set tcp dport map @secmapping_in
		ct state established,related ct direction original meta iifname != "lo" meta secmark set udp dport map @secmapping_in

		# 5. remember it: new flows in full, repaired flows written back
		ct state new ct secmark set meta secmark
		ct state established,related ct direction original meta iifname != "lo" ct secmark set meta secmark
	}

	chain output {
		type filter hook output priority 225; policy accept;

		ct state established,related meta secmark set ct secmark

		# as in the input chain: ICMP from the protocol alone, in every state
		# (dhcpcd's router solicitation is the send side of the same exchange).
		ip6 nexthdr icmpv6 meta secmark set "icmp_server"
		ip protocol icmp meta secmark set "icmp_server"
		ct state untracked oif lo meta secmark set "local"
		ct state untracked meta oifname != "lo" meta secmark set "unclassified"
		ct state new oif lo meta secmark set "local"
		ct state new meta oifname != "lo" meta secmark set "unclassified"

		ct state new meta secmark set tcp dport map @secmapping_out
		ct state new meta secmark set udp dport map @secmapping_out


		oif lo tcp dport 22 ip6 saddr ::1 ip6 daddr ::1 meta secmark set "ssh_client"
		oif lo udp dport 22 ip6 saddr ::1 ip6 daddr ::1 meta secmark set "ssh_client"
		oif lo tcp dport 22 ip saddr 127.0.0.1 ip daddr 127.0.0.1 meta secmark set "ssh_client"
		oif lo udp dport 22 ip saddr 127.0.0.1 ip daddr 127.0.0.1 meta secmark set "ssh_client"

		ct state established,related ct direction original meta oifname != "lo" meta secmark set tcp dport map @secmapping_out
		ct state established,related ct direction original meta oifname != "lo" meta secmark set udp dport map @secmapping_out

		ct state new ct secmark set meta secmark
		ct state established,related ct direction original meta oifname != "lo" ct secmark set meta secmark
	}
}
