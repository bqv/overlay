policy_module(desktop.system.sysadm, 1.0)

gen_require(`
  type auditd_log_t;
  type ldconfig_t;
  type mozilla_t;
  type nsfs_t;
  type portage_fetch_t;
  type portage_sandbox_t;
  type portage_t;
  type rtkit_daemon_t;
  type semanage_t;
  type setfiles_t;
  type ssh_t;
  type staff_t;
  type sysadm_screen_t;
  type sysadm_t;
  type system_dbusd_t;
  type unlabeled_t;
  type user_t;
  attribute domain;
  class fifo_file { getattr ioctl open read unlink write };
  class netlink_generic_socket { append bind connect create getattr getopt ioctl read setattr setopt shutdown write };
  class process { getcap noatsecure rlimitinh setexec siginh transition };
')

# The admin user's session: sysadm_t, and the screen domain derived from it.
#
# The sysadmin's own grants; a rule found while triaging a service is noted on the rule.
# Method and evidence: the local TRIAGE ledger, which is kept out of this repository.

files_search_default(sysadm_screen_t)

allow sysadm_t domain:process { getcap }; # htop
dontaudit sysadm_t ldconfig_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t portage_fetch_t:process { noatsecure rlimitinh siginh };
allow sysadm_t portage_sandbox_t:process { transition };
dontaudit sysadm_t portage_sandbox_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t portage_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t semanage_t:process { noatsecure rlimitinh siginh };
dontaudit sysadm_t setfiles_t:process { noatsecure rlimitinh siginh };
allow sysadm_t unlabeled_t:process getattr;
# `sudo nginx -t` binds the listening sockets to validate them, and under sudo nginx
# runs in sysadm_t (there is no sysadm_t -> nginx_t transition), so the config test was
# denied name_bind on http_port_t.
corenet_tcp_bind_generic_node(sysadm_t)
corenet_tcp_bind_http_port(sysadm_t)
kernel_read_unlabeled_files(sysadm_t) # htop / proc
kernel_manage_unlabeled_symlinks(sysadm_t) # htop / proc

read_files_pattern(sysadm_t, auditd_log_t, auditd_log_t)
allow sysadm_t mozilla_t:process getcap;
allow sysadm_t rtkit_daemon_t:process getcap;
allow sysadm_t ssh_t:process getcap;
allow sysadm_t staff_t:fifo_file write;
allow sysadm_t staff_t:process getcap;
allow sysadm_t system_dbusd_t:process getcap;
allow sysadm_t user_t:process getcap;

getattr_files_pattern(sysadm_t, nsfs_t, nsfs_t)

# Appended from sec-policy/selinux-desktop-home (files/desktop.home.te).
# The receiving module's gen_require block is NOT included or altered here.

# sysadm_screen_t: this module owns the screen domain derived from sysadm_t
# ("The admin user's session: sysadm_t, and the screen domain derived from it";
# type sysadm_screen_t in its gen_require, files_search_default at line 31), so
# the transition permission on that pair belongs here.
allow sysadm_t sysadm_screen_t:process { noatsecure rlimitinh siginh };

# --- r58: wg needs a generic netlink socket, and sysadm_t had none ---
#
# Measured 2026-10-12 (handed over raw): `sudo -n wg-quick up wg0` got as far as
# `wg addconf wg0 /dev/fd/63` and then failed with "Unable to modify interface: Permission denied",
# tearing the interface down again:
#
#   avc: denied { create } for comm="wg" scontext=staff_u:sysadm_r:sysadm_t
#        tcontext=staff_u:sysadm_r:sysadm_t tclass=netlink_generic_socket
#   syscall=41(AF_NETLINK/SOCK_RAW/NETLINK_GENERIC=16) success=no exit=-13
#
# `ip link add dev wg0 type wireguard` (rtnetlink) succeeded just before it, so what was missing is the
# generic-netlink half of the WireGuard API, not netlink as a whole. wg talks to the kernel wireguard
# family over NETLINK_GENERIC; rtnetlink only creates the interface.
#
# The permission set is the one already measured for the same API one package over: netbird's wgctrl
# path uses the identical family, and this is that set (desktop.system.netbird round 2). refpolicy's own
# wireguard module grants its domain create_socket_perms on this class for the same reason - but that
# module is NOT in this box base policy: wireguard_t does not exist in the loaded policy and
# /usr/bin/wg is bin_t rather than wireguard_exec_t, so wg runs in the caller's domain and the caller
# is the one that has to open the socket. Enabling (or vendoring) that module would confine wg to a
# wireguard_t of its own instead; until then this is the grant that makes the tool work, and it is the
# same shape the session domain already has next door in desktop.system.staff.te.
allow sysadm_t self:netlink_generic_socket { append bind connect create getattr getopt ioctl read setattr setopt shutdown write };
