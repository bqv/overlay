policy_module(desktop.system.network, 1.0)

gen_require(`
	attribute client_packet_type;
	attribute packet_type;
	type staff_t;
	type sysadm_t;
	type stremio_server_t;
	type mozilla_t;
	type gajim_t;
	type shortwave_t;
	type ssh_t;
	type nginx_t;
	type staff_bubblewrap_t;
	type dhcpc_t;
	type ssh_client_packet_t;
	type http_client_packet_t;
	type http_server_packet_t;
	type adb_client_packet_t;
	type adb_server_packet_t;
	type icmp_packet_t;
	type dhcpd_client_packet_t;
	class packet { recv send };
	class icmp_socket { create getopt read setopt write };
	type dhcpc_script_t;
	type init_runtime_t;
	type iptables_t;
	type nscd_runtime_t;
	type unlabeled_t;
	class process { getcap noatsecure rlimitinh setexec siginh transition };
')

########################################
#
# Packet labelling - the SELinux half of files/ruleset.nftables.
#
# That ruleset gives every packet a SELinux secmark (a *_packet_t type) from
# its protocol, port and direction, and the kernel then checks send/recv
# against it. Anything the maps do not cover arrives as unlabeled_t.
#
# Every rule here comes from a capture in captures/. Where no packet type
# exists, one is declared rather than granting a blanket unlabeled exception,
# so the secmark keeps covering the traffic.
#
# r15 coverage rule: a flow is either labelled and allowed by name, or left
# denied on purpose. The only "everything else" bucket is local_packet_t, and
# it is scoped to iif/oif lo in the ruleset, so it can never cover off-box
# traffic. It is not an unlabeled_t grant: the traffic is labelled, just not
# distinguishable by port because the kernel picks the port dynamically.
#

###
### mosh - UDP 60001/60002
###
# refpolicy has no mosh_packet_t. packet_type is the attribute that makes a
# type usable as a secmark - cf. corenet_client_packet()/corenet_server_packet().
type mosh_packet_t;
typeattribute mosh_packet_t packet_type;

# mosh is symmetric: the outbound map labels the packets and conntrack carries
# the secmark back onto the replies, so one mapping covers both directions.
allow staff_t mosh_packet_t:packet { send recv };

###
### nginx - serves :80, and connects out to the local gate on :8080
###
# Serving HTTP is already labelled http_server by the ruleset's secmapping_in,
# but nothing allowed nginx_t to send or receive it - 30 send + 30 recv denials.
allow nginx_t http_server_packet_t:packet { send recv };

# The :8080 hop to the gate was unmapped, so it arrived as unlabeled_t (35 + 35
# denials). It is mapped to http_client now, and allowed here.
allow nginx_t http_client_packet_t:packet { send recv };

# nginx reaches the local gate at 127.0.0.1:8080, and port 8080 is labelled
# http_cache_port_t, so the connection needs name_connect on that port type.
# Without it enforcing stops nginx talking to the gate and the web UI dies.
corenet_tcp_connect_http_cache_port(nginx_t)

###
### mDNS - UDP 5353
###
# No mdns_packet_t exists in refpolicy either, and the ruleset did not label
# 5353, so multicast discovery arrived as unlabeled_t for staff_bubblewrap_t.
type mdns_packet_t;
typeattribute mdns_packet_t packet_type;

allow staff_bubblewrap_t mdns_packet_t:packet { send recv };

# Labelling 5353 showed that mDNS is not only the sandbox: staff_t and
# stremio_server_t were doing it too, and the label turned their previous
# unlabeled_t denials into mdns_packet_t ones. Allow the domains the captures
# actually show rather than leaving them denied.
allow staff_t mdns_packet_t:packet { send recv };
allow stremio_server_t mdns_packet_t:packet { send recv };

# mozilla_t added on request. Firefox is the one plausible LAN-discovery client
# that had been left out of this list, and unlike staff_t / stremio_server_t /
# sysadm_t it has no capture behind it - no mdns_packet_t denial has ever been
# recorded from mozilla_t - so this is a completeness grant, not a triaged one.
# Firefox does answer the WebRTC host-candidate mDNS queries other LAN devices
# send it, and that is the same type.
allow mozilla_t mdns_packet_t:packet { send recv };

###
### stremio's streaming server - TCP 11471
###
# server.js binds *:11471, so a LAN client (the user's own player) reaches it and
# the traffic was covered only by stremio_server_t's blanket unlabeled_t grant.
# The ruleset labels the port http_server now, so the flow is named and the
# specific allow replaces the blanket for it.
allow stremio_server_t http_server_packet_t:packet { send recv };

###
### stremio
###
# Stremio connects outward to :22, which secmapping_out labels ssh_client, so
# its traffic is checked against ssh_client_packet_t. Masked today only because
# stremio_server_t sits in a permissive domain.
allow stremio_server_t ssh_client_packet_t:packet { send recv };

###
### adb / the Android emulator - TCP 5037, 5554, 5555, UDP 5353
###
# The emulator stack (qemu-system-x86, adb, adbtrack, netsimd) runs in sysadm_t.
# A r15 capture over two hours shows 86 send + 86 recv mdns_packet_t denials and
# ~150 unlabeled_t ones on ports 5555, 5037, 1970, 33063, 40012, 41357, 34534 and
# 57168. 5353 is adb's wireless-debugging discovery, so it is normal traffic and
# gets the label it already has.
allow sysadm_t mdns_packet_t:packet { send recv };

# 5037 is the adb server port and 5554/5555 the emulator console/adb ports; the
# ruleset maps them to the adb packet types. adb also connects *outward* to
# 5555 on a phone for wireless debugging, which is why both directions are
# labelled and both types are allowed rather than one.
allow sysadm_t adb_server_packet_t:packet { send recv };
allow sysadm_t adb_client_packet_t:packet { send recv };

###
### loopback-local traffic
###
# The emulator's other ports (1970, 33063, 40012, 41357, 34534, 57168) and the
# local services the desktop talks to on loopback (the model router on :55555,
# the carrier on :8081, adb's own sockets) are chosen dynamically, so no port
# map can name them.
#
# A loopback flow is labelled exactly once, by the output chain that generated
# it: `ct state new oif lo meta secmark set "local"`, then the outbound port map,
# so a named label wins where there is one. The input chain does NOT repeat
# either step - a loopback packet passes both chains, and the inbound map holds
# different ports, so re-deriving there would label one flow two different ways
# (a browser flow to 127.0.0.1:80 came out http_server on the input side while
# the output side had said http_client). The map lookup leaves the value alone
# when the key is missing - measured, not assumed - which is what lets the
# default stand where no port names the flow. Because every rule is oif lo,
# this type can only ever cover traffic that does not leave the machine.
type local_packet_t;
typeattribute local_packet_t packet_type;

###
### dynamic_packet_t - traffic on ports no map can name
###
# The last thing that was still reaching for an unlabeled_t blanket. A few
# applications legitimately use ports that cannot be known in advance:
# BitTorrent picks its listen port at runtime and receives inbound peer
# connections on it, WebRTC picks UDP ports per call, internet radio streams on
# whatever port the station publishes, and ssh can be pointed at any port. The
# ruleset labels every unclassified non-loopback packet dynamic_packet_t, so this
# is not an unlabeled_t grant: the traffic is labelled, the label is ours, and it
# is granted per domain rather than wholesale. It also means unlabeled_t packets
# should no longer occur at all - any that do are a signal that labelling broke.
#
# This replaces six corenet_sendrecv_unlabeled_packets() grants. For the domains
# listed it is coverage-equivalent; the tightening is that inbound flows no map
# names are now denied for every domain *not* listed here.
type dynamic_packet_t;
typeattribute dynamic_packet_t packet_type;
allow mozilla_t dynamic_packet_t:packet { send recv };
allow gajim_t dynamic_packet_t:packet { send recv };
allow shortwave_t dynamic_packet_t:packet { send recv };
allow stremio_server_t dynamic_packet_t:packet { send recv };
allow ssh_t dynamic_packet_t:packet { send recv };
allow staff_t dynamic_packet_t:packet { send recv };
# dhcpcd keeps it as a safety net, and the reason is worth recording honestly:
# the r18 note claimed the zero-denial observation after the 08:16 renewal proved
# the labelling. It did not - the CIL still carried `(allow dhcpc_t unlabeled_t)`,
# which would have covered any unlabelled path silently. The ports are mapped by
# definition (67/68 and 546/547, both directions), so this should never be used;
# a renewal that shows `dhcpd_client_packet_t` in conntrack is what would let it
# be dropped. Losing the lease is the one flow failure that would cut this box off
# the network, so it keeps a net until that observation exists.
allow dhcpc_t dynamic_packet_t:packet { send recv };

# dhcpcd holds promiscuous AF_PACKET sockets - three of them, and one is bound to eno1
# (ss -0apne: fd=21, ino 8006) - so the kernel checks `packet recv` for dhcpc_t against
# the secmark of every inbound packet on both interfaces. The client-flow labels are this
# box's own outbound flows, which dhcpcd can never read: 3525 http + 423 dns + 19 mdns
# denials in one boot, with nothing failing. So dontaudit rather than grant - and the
# attribute is right because it covers every client label the ruleset can assign, not
# only the ones this boot happened to produce.
dontaudit dhcpc_t client_packet_type:packet recv;
dontaudit dhcpc_t mdns_packet_t:packet recv;

allow sysadm_t local_packet_t:packet { send recv };
allow staff_t local_packet_t:packet { send recv };
allow nginx_t local_packet_t:packet { send recv };
# The browser talks to local services too (the web UI on :80 and the gates on
# :8080/:8081), and any loopback port no map names is local_packet_t now instead
# of unlabeled_t - so without this the browser's next receive is denied, which is
# exactly what the first post-merge window showed. mozilla_t's unlabeled_t grant
# no longer covers these flows because they are no longer unlabeled.
allow mozilla_t local_packet_t:packet { send recv };

###
### dhcpcd - DHCPv4 UDP 67/68, DHCPv6 UDP 546/547
###
# refpolicy already allows dhcpc_t dhcpd_client_packet_t; what was missing was
# the labelling, so DHCP arrived as unlabeled_t and needed the blanket grant in
# desktop.system.base.te. The ruleset maps the four ports now, so the specific
# allow is written out here too and the blanket can go.
allow dhcpc_t dhcpd_client_packet_t:packet { send recv };

# The blanket that used to sit next to this in desktop.system.base.te is gone:
# the lease renewed at 08:16 on 1 Oct, after this mapping went in, with zero
# dhcpc_t packet denials.

###
### ICMP - ping from the session
###
# The session's sandbox sets no_new_privs, so ping does not transition to ping_t
# and stays in staff_t. It then needs the ICMP socket itself and the packet label
# the ruleset puts on ICMP (icmp_packet_t via the "icmp_server" secmark).
# refpolicy has no interface for either - ping_t's own grants are raw allows.
allow staff_t self:icmp_socket { create getopt read setopt write };
allow staff_t icmp_packet_t:packet { send recv };


# --- moved here when desktop.system.base was split by consumer (2026-10-03) ---
#
# dhcpcd's run-hooks script, and the secmark relabel nft performs on the first
# packet of every flow. Both belong to this module's one consumer: the packet
# labels and the ruleset in files/ruleset.nftables that assigns them.

kernel_read_kernel_sysctls(dhcpc_script_t)
nscd_read_runtime_files(dhcpc_script_t)
selinux_getattr_fs(dhcpc_script_t)
seutil_search_default_contexts(dhcpc_script_t)

dontaudit dhcpc_t dhcpc_script_t:process { noatsecure rlimitinh siginh };
# r18: the dhcpc_t unlabeled_t grant is gone. It existed because nothing
# labelled the DHCP ports; the ruleset maps 67/68/546/547 now, and the
# lease renewed at 08:16 on 1 Oct - after the labelling - with zero
# dhcpc_t packet denials. Verified by evidence, not by assumption.

# dhcpcd-run-hook searches the init runtime directory; refpolicy has no search
# interface for it (only create/delete/dontaudit), so this is a raw allow.
search_dirs_pattern(dhcpc_script_t, init_runtime_t, init_runtime_t)
search_dirs_pattern(dhcpc_script_t, nscd_runtime_t, nscd_runtime_t)
# --- r20c: what the corrected full-log sweep found still missing (part 1) ---
# Every line here answers a specific tuple that the running policy does not allow,
# from a sweep that checks each permission separately.
# THE critical one. nft assigns a secmark to every packet; the first packet of a
# flow has no label yet, so the assignment is a relabelto from unlabeled_t. Only
# packet_type is granted (from the original ruleset), and unlabeled_t is not in
# that attribute - so under enforcing the labelling itself would be denied and
# traffic would stay unlabelled, taking the whole network half with it.
allow iptables_t unlabeled_t:packet relabelto;
