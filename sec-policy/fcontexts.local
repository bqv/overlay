# Local file contexts for this box - the shared /home/user design.
#
# These live in /etc/selinux/mcs/contexts/files/file_contexts.local (the local
# db), NOT in a module .fc, and that is deliberate: libselinux consults
# file_contexts.homedirs BEFORE file_contexts for paths under a home, so a
# module-level rule for /home/user would be shadowed by the generated homedir
# template. The local db is checked first and therefore wins.
#
# Design: branch, stem and leaf are three identities sharing one /home/user.
#   - the home DIRECTORY belongs to the admin identity (stem -> sysadm_u). Only the
#     directory: a broad /home/user(/.*)? rule would flatten every type-specific path
#     under it (~/.cache -> user_home_t instead of xdg_cache_t, ~/.local/bin ->
#     user_home_t instead of user_bin_t), which is not what was asked for.
#   - the source trees are worked in by staff_u (the session and the agent),
#     so they stay staff_u and get the home_t types back rather than being
#     swept into xdg_data_t by the default /home/user(/.*)? rule
#   - pnpm keeps its own tool binaries under ~/.local/share, which the default
#     labelling makes non-executable (that broke pnpm under enforcing)
#
# Reapply with these commands (or copy the contexts list and run
# sefcontext_compile + a policy reload):
#
#   semanage fcontext -a -s sysadm_u -t user_home_dir_t "/home/user"
#   semanage fcontext -a -s sysadm_u -t user_home_t     "/home/user(/.*)?"
#   semanage fcontext -a -s staff_u  -t user_home_t     "/home/user/\.local/src(/.*)?"
#   semanage fcontext -a -s staff_u  -t git_home_t      "/home/user/\.local/src(/.*)?/\.git(/.*)?"
#   semanage fcontext -a -s staff_u  -t user_bin_t      "/home/user/\.local/share/pnpm(/.*)?"
#
/home/user    sysadm_u:object_r:user_home_dir_t:s0
/home/user/\.local/src(/.*)?    staff_u:object_r:user_home_t:s0
/home/user/\.local/src(/.*)?/\.git(/.*)?    staff_u:object_r:git_home_t:s0
/home/user/\.local/share/pnpm(/.*)?    staff_u:object_r:user_bin_t:s0

# OpenRC's own checkpath. The refpolicy tmpfiles module labels this path
# tmpfiles_exec_t, which makes every `checkpath` call by any init script
# transition into the system tmpfiles domain - and, under enforcing, makes
# staff_t unable to even stat it. /etc/init.d/user calls checkpath in
# start_pre, so the user session's services could not be set up at all: the
# service's own state dir under /run/openrc/user was never created.
#
# Every other one of the 45 helpers in that directory is bin_t, and the file is
# built from openrc-0.64.1/src/checkpath - it is OpenRC's tool, not
# systemd-tmpfiles'. tmpfiles_t may execute bin_t, so the relabel costs the
# tmpfiles service nothing.
#
#   semanage fcontext -a -s system_u -t bin_t "/usr/libexec/rc/bin/checkpath"
#
/usr/libexec/rc/bin/checkpath    system_u:object_r:bin_t:s0

# nginx's runtime directory. /run is a fresh tmpfs every boot and refpolicy's
# rule for it is `/run/.*  <<None>>` plus per-path exceptions; /run/nginx has no
# exception, so OpenRC's checkpath created it as initrc_runtime_t - a generic
# init type nginx_t has no permission on at all - and did so again every boot.
# That is why nginx kept failing to write its pid file even after the port was
# free, and why the first two attempts to fix it (grants on initrc_runtime_t)
# were treating the symptom: nginx_t already holds the *complete* permission set
# for nginx_runtime_t, the type the directory should have had all along.
#
#   semanage fcontext -a -s system_u -t nginx_runtime_t "/run/nginx(/.*)?"
#
/run/nginx(/.*)?    system_u:object_r:nginx_runtime_t:s0
